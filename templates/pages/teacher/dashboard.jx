{#- The teacher's home: roster totals, the school's invite code, quick links to people, attendance
    and worksheets, then the unmatched learners and the newest pairs. -#}
{#import "@components/shell/page.jx" as Page #}
{#import "@components/section_badge.jx" as SectionBadge #}
{#import "@components/stat_tile.jx" as StatTile #}
{#import "@components/quick_action.jx" as QuickAction #}
{#import "@components/base/card.jx" as Card #}
{#import "@components/base/button.jx" as Button #}
{#import "@components/base/icon.jx" as Icon #}
{#import "@components/base/progress_bar.jx" as ProgressBar #}
{#import "@components/shell/main.jx" as Main #}
{#def teacher, matched_pairs, unmatched_learners, unmatched_volunteers, total_learners, total_volunteers,
    total_people, active_matches, total_learning_hours, invite_code, pending_announcement=None #}
<Page title={{ t('teacher.dashboard.title') }} styles="admin" announcement={{ pending_announcement }}>
  <Main>
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
      <div>
        <SectionBadge>{{ t('teacher.portal_badge') }}</SectionBadge>
        <h1 class="display-font text-2xl md:text-4xl font-extrabold text-sky-950">{{ t('teacher.dashboard.heading') }}</h1>
        <p class="text-sm md:text-base mt-1 text-ink-heading/60">
          {{ t('teacher.dashboard.welcome', name=teacher.name or 'Teacher') }}
        </p>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      <StatTile icon="users" label={{ t('teacher.dashboard.total_people') }} value={{ total_people }} />
      <StatTile tone="green" icon="check-circle" label={{ t('teacher.dashboard.active_matches') }} value={{ active_matches }} />
      <StatTile tone="amber" icon="clock" label={{ t('teacher.dashboard.total_hours') }} value={{ "%.1f" | format(total_learning_hours) }} />
      <StatTile tone="rose" icon="exclamation-triangle" label={{ t('teacher.dashboard.unmatched_learners') }} value={{ unmatched_learners | length }} />
    </div>

    <div class="mb-8">
      <SectionBadge>{{ t('teacher.invite_code_card_title') }}</SectionBadge>
      {%- if invite_code %}
      <Card tone="green" class="p-6 mt-3 flex flex-col md:flex-row items-start md:items-center gap-4 justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-accent mb-1">{{ t('teacher.invite_code_card_title') }}</p>
          <div id="invite-code-value" class="display-font text-4xl font-extrabold text-sky-950 tracking-widest">{{ invite_code }}</div>
        </div>
        <div class="flex flex-col gap-2 shrink-0">
          <p class="text-xs text-ink-muted max-w-xs">{{ t('teacher.invite_code_desc') }}</p>
          <form method="POST" action="{{ url_for('teacher.regenerate_invite') }}" class="js-ajax-form" id="regen-invite-form">
            <Button type="submit" variant="sky">{{ t('teacher.invite_code_regenerate') }}</Button>
          </form>
        </div>
      </Card>
      {%- else %}
      <Card tone="amber" class="p-6 mt-3">
        <p class="text-sm text-amber-700 font-semibold">{{ t('teacher.dashboard.no_school') }}</p>
      </Card>
      {%- endif %}
    </div>

    <div class="mb-2">
      <SectionBadge>{{ t('teacher.dashboard.quick_actions') }}</SectionBadge>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
      <QuickAction href={{ url_for('teacher.teacher_people') }} icon="users"
        title={{ t('teacher.dashboard.manage_people') }} description={{ t('teacher.dashboard.manage_people_desc') }} />
      <QuickAction tone="green" href={{ url_for('teacher.teacher_attendance') }} icon="check-circle"
        title={{ t('teacher.dashboard.log_attendance') }} description={{ t('teacher.dashboard.log_attendance_desc') }} />
      <QuickAction tone="amber" href={{ url_for('teacher.teacher_worksheets') }} icon="book-open"
        title={{ t('teacher.dashboard.view_worksheets') }} description={{ t('teacher.dashboard.view_worksheets_desc') }} />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <Card tone="rose">
        <div class="flex items-center justify-between mb-4">
          <h3 class="display-font font-bold text-base text-sky-900 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
            {{ t('teacher.dashboard.priority_unmatched') }}
          </h3>
          <a href="{{ url_for('teacher.teacher_people') }}" class="text-xs font-bold text-sky-500 hover:text-sky-700 transition-colors">{{ t('teacher.dashboard.view_all') }}</a>
        </div>
        <div class="space-y-2">
          {%- if unmatched_learners %}
          {%- for learner in unmatched_learners[:3] %}
          <div class="list-item-clay flex justify-between items-center">
            <div>
              <a href="{{ url_for('teacher.teacher_learner_detail', learner_id=learner.id) }}" class="text-sm font-semibold text-primary-dark hover:text-primary transition-colors">
                {{ learner.name or learner.username }}
              </a>
              <p class="text-[10px] text-rose-400 font-semibold uppercase tracking-wide mt-0.5">{{ t('teacher.dashboard.unmatched_learner') }}</p>
            </div>
            <span class="w-2 h-2 rounded-full bg-rose-400 flex-shrink-0"></span>
          </div>
          {%- endfor %}
          {%- else %}
          <div class="py-6 text-center rounded-xl border-2 border-dashed border-green-200 bg-green-50">
            <Icon name="check-circle" size="8" class="text-green-400 mx-auto mb-2" />
            <p class="text-sm text-accent font-semibold">{{ t('teacher.dashboard.all_matched') }}</p>
          </div>
          {%- endif %}
        </div>
      </Card>

      <Card tone="green">
        <div class="flex items-center justify-between mb-4">
          <h3 class="display-font font-bold text-base text-sky-900 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-green-500"></span>
            {{ t('teacher.dashboard.active_pairs') }}
          </h3>
          <a href="{{ url_for('teacher.teacher_people') }}" class="text-xs font-bold text-sky-500 hover:text-sky-700 transition-colors">{{ t('teacher.dashboard.view_all') }}</a>
        </div>
        <div class="space-y-2">
          {%- if matched_pairs %}
          {%- for pair in matched_pairs[:3] %}
          <div class="list-item-clay !border-green-200 flex justify-between items-center">
            <div>
              <a href="{{ url_for('teacher.teacher_learner_detail', learner_id=pair.learner.id) }}" class="text-sm font-semibold text-primary-dark hover:text-primary transition-colors">
                {{ pair.learner.name or pair.learner.username }} &amp; {{ pair.volunteer.name or 'Volunteer' }}
              </a>
              <p class="text-[10px] text-accent font-semibold mt-0.5">{{ pair.subject }} &bull; {{ pair.progress }}{{ t('teacher.dashboard.percent_complete') }}</p>
            </div>
            <div class="w-14 flex-shrink-0">
              <ProgressBar value={{ pair.progress }} tone="green" size="xs" />
            </div>
          </div>
          {%- endfor %}
          {%- else %}
          <div class="py-6 text-center rounded-xl border-2 border-dashed border-primary-light bg-surface-card">
            <p class="text-sm text-ink-faint italic">{{ t('teacher.dashboard.no_pairs') }}</p>
          </div>
          {%- endif %}
        </div>
      </Card>
    </div>
  </Main>

  <script>
    document.getElementById("regen-invite-form")?.addEventListener("ajaxform:success", (e) => {
      const { invite_code } = e.detail;
      if (invite_code) document.getElementById("invite-code-value").textContent = invite_code;
    });
  </script>
</Page>
