{#- The school's donation ledger. The headline totals cover every donation; the pager swaps only
    the table. -#}
{#import "@components/shell/page.jx" as Page #}
{#import "@components/back_link.jx" as BackLink #}
{#import "@components/section_badge.jx" as SectionBadge #}
{#import "@components/stat_tile.jx" as StatTile #}
{#import "@page_components/school_admin/donations_results.jx" as DonationsResults #}
{#import "@components/shell/main.jx" as Main #}
{#def school, donations, donation_count, total, page, page_count #}
<Page title={{ "Donations — " ~ school.name }}>
  <Main>
    <BackLink href={{ url_for('school_admin.dashboard') }} label="Dashboard" />

    <div class="mb-6">
      <SectionBadge tag="div">{{ t('school_admin.donations.eyebrow') }}</SectionBadge>
      <h1 class="display-font text-3xl md:text-4xl font-extrabold text-sky-950 mt-1">{{ school.name }}</h1>
    </div>

    <div class="grid grid-cols-2 gap-4 mb-8">
      <StatTile tone="green" icon="currency-dollar" label={{ t('school_admin.donations.stat_total_raised') }} value={{ "$%.2f" | format(total) }} />
      <StatTile icon="heart" label={{ t('school_admin.donations.stat_donations') }} value={{ donation_count }} />
    </div>

    <DonationsResults school={{ school }} donations={{ donations }} page={{ page }} page_count={{ page_count }} />
  </Main>
</Page>
