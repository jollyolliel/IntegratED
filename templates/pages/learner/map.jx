{#- The placement (MAP) test: one question at a time from /api/map/question (multiple choice or
    an open answer, with optional audio). The last answer hands over through the sign-up journey's
    loader ("looking at your answers" → the pin drops) to the completion card, which leads with the
    recommended course and its first topic when the result has one. -#}
{#import "@components/shell/page.jx" as Page #}
{#import "@components/audio_button.jx" as AudioButton #}
{#import "@components/icon_box.jx" as IconBox #}
{#import "@components/base/card.jx" as Card #}
{#import "@components/base/icon.jx" as Icon #}
{#import "@components/base/button.jx" as Button #}
{#import "@components/mc_options.jx" as McOptions #}
{#import "@components/journey_loader.jx" as JourneyLoader #}
{#import "@components/journey_scene.jx" as JourneyScene #}
<Page title={{ t('learner.map.title') }} styles="learning-nav">
  <main class="flex-1 flex flex-col relative w-full">
    <div class="container mx-auto px-4 py-10 flex-1 flex flex-col items-center justify-start max-w-2xl">

      <div id="loading-indicator" class="hidden flex flex-col items-center py-16" role="status" aria-live="polite">
        <div class="w-16 h-16 rounded-2xl bg-primary-soft border-2 border-primary-light flex items-center justify-center mb-4">
          <div class="map-spinner" aria-hidden="true"></div>
        </div>
        <p class="text-sky-400 font-semibold">{{ t('learner.map.loading') }}</p>
      </div>

      <div id="quiz-interface" class="w-full space-y-6">

        <Card>
          <div class="flex items-start justify-between gap-4 mb-3">
            <p class="text-xs font-bold uppercase tracking-widest text-sky-400 mt-1" id="question-prompt">
              {{ t('learner.map.in_progress') }}
            </p>
            <div id="audio-container" class="hidden flex-shrink-0">
              <AudioButton label={{ t('learner.map.play_audio') }} onclick="playQuestionAudio()" />
            </div>
          </div>
          <h1 class="display-font text-2xl md:text-3xl font-extrabold text-sky-950 leading-tight" id="question-text-title">
            {{ t('learner.map.loading_question') }}
          </h1>
          <div id="question-text" class="text-lg text-primary hidden leading-relaxed mt-3"></div>
          {#- A listening question: the speaker is the question, so it sits big in the middle of the card. -#}
          <div id="listen-card" class="hidden mt-6">
            <div class="flex justify-center">
              <AudioButton size="lg" label={{ t('learner.map.play_audio') }} onclick="playQuestionAudio()" />
            </div>
          </div>
          <audio id="question-audio"></audio>
        </Card>

        <div id="options-container" class="grid gap-3"></div>

        <div id="open-answer-container" class="hidden">
          <textarea id="open-answer-input"
            class="map-textarea"
            rows="4"
            placeholder="{{ t('learner.map.answer_placeholder') }}"></textarea>
        </div>

        <div class="flex justify-end pt-2">
          <Button id="next-button" icon_end="arrow-right" disabled>{{ t('learner.map.submit') }}</Button>
        </div>
      </div>

      <div id="completion-state" class="hidden text-center py-16 space-y-8 max-w-md mx-auto w-full">
        <Card class="text-center">
          <JourneyScene name="quiz" class="w-28 h-28 mx-auto mb-4" />
          <h2 class="display-font text-3xl font-extrabold text-sky-950 mb-3">{{ t('learner.map.complete_title') }}</h2>
          <p class="text-sky-400 leading-relaxed mb-6">
            {{ t('learner.map.complete_subtitle') }}
          </p>

          {#- Recommended starting topic (filled in from the result): the same shape as
              #nextLessonCard in components/completion_overlay.jx — label, one clickable topic
              card, an OR divider, then the secondary dashboard link. -#}
          <div id="recommendation-section" class="hidden space-y-3 text-start mb-6">
            <p class="text-xs font-bold uppercase tracking-widest text-accent-dark">{{ t('learner.map.recommend_label') }}</p>

            <Card tone="green" href="#" id="recommendation-start-btn" class="!p-3 flex items-center gap-3">
              <IconBox icon="book-open" tone="green" />
              <div class="flex-1 min-w-0">
                <p class="text-xs font-bold text-accent-dark" id="recommendation-course"></p>
                <h3 class="font-bold text-base text-green-900" id="recommendation-topic"></h3>
                <p class="text-xs text-accent-dark">{{ t('learner.map.recommend_hint') }}</p>
              </div>
              <Icon name="chevron-right" class="text-green-400 flex-shrink-0" />
            </Card>

            <div class="flex items-center gap-3">
              <div class="flex-1 h-px bg-green-200"></div>
              <span class="text-xs font-bold text-accent-dark">{{ t('learner.map.or') }}</span>
              <div class="flex-1 h-px bg-green-200"></div>
            </div>
          </div>

          {#- The primary action when there is no recommendation; the script drops it to the sky
              variant once the card above appears. -#}
          <Button href={{ url_for('learner.learner_dashboard') }} id="dashboard-link" class="w-full">
            {{- t('learner.map.go_to_dashboard') -}}
          </Button>
        </Card>
      </div>
    </div>
  </main>

  <JourneyLoader scene="quiz" step={{ 3 }} working={{ t('journey.quiz.working') }} done={{ t('journey.quiz.done') }} />
  <McOptions />
  <script>
    var currentQuestion = null;
    var selectedAnswer = null;
    var MAP_T = {
      questionFallback: {{ t('learner.map.question_fallback') | tojson }},
      listenTitle: {{ t('learner.map.listen_title') | tojson }},
      loadError: {{ t('learner.map.load_error') | tojson }},
      allDone: {{ t('journey.quiz.done_plain') | tojson }},
      recommendCourse: {{ t('learner.map.recommend_course') | tojson }},
    };

    // Read the question aloud with the browser's voice (no recording, or the recording failed).
    function speakQuestion() {
      if (!currentQuestion || !("speechSynthesis" in window)) return;
      const holder = document.createElement("div");
      holder.innerHTML = currentQuestion.question_text || currentQuestion.question_prompt || "";
      speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(
        holder.textContent.replace(/_{2,}/g, " blank "),
      );
      utterance.lang = "en-US";
      utterance.rate = 0.85;
      speechSynthesis.speak(utterance);
    }

    // `auto` is the play on arrival, which the browser may block until a tap: say nothing then.
    function playQuestionAudio(auto = false) {
      const audio = document.getElementById("question-audio");
      if (audio.getAttribute("src")) {
        audio.play().catch(() => {
          if (!auto) speakQuestion();
        });
      } else if (!auto) {
        speakQuestion();
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
      loadNewMAPQuestion();
    });

    // An emoji in a question is the picture to find: wrap each one so it is drawn big.
    const EMOJI_RE =
      /\p{Extended_Pictographic}(?:️|‍\p{Extended_Pictographic}|[\u{1F3FB}-\u{1F3FF}])*/gu;

    function setTextWithBigEmoji(el, text) {
      el.textContent = "";
      let last = 0;
      for (const m of text.matchAll(EMOJI_RE)) {
        el.append(text.slice(last, m.index));
        const span = document.createElement("span");
        span.className = "map-emoji";
        span.textContent = m[0];
        el.append(span);
        last = m.index + m[0].length;
      }
      el.append(text.slice(last));
    }

    // Every question can be heard: its recording, else the browser's voice. A listening question
    // swaps the small speaker row for one big speaker.
    function showAudioControls(question, listening) {
      const hasRecording = !!(question.question_sound && question.question_sound_url);
      const canHear = hasRecording || "speechSynthesis" in window;
      document.getElementById("listen-card").classList.toggle("hidden", !listening);
      document.getElementById("audio-container").classList.toggle("hidden", listening || !canHear);
    }

    // Show the question's words, or, for a listening question, only a generic "listen" title.
    function showQuestionWords(question, listening) {
      showAudioControls(question, listening);
      setTextWithBigEmoji(
        document.getElementById("question-text-title"),
        listening
          ? MAP_T.listenTitle
          : question.question_prompt || MAP_T.questionFallback,
      );

      const textEl = document.getElementById("question-text");
      if (
        !listening &&
        question.question_text &&
        question.question_text !== question.question_prompt
      ) {
        textEl.innerHTML = question.question_text.replace(
          EMOJI_RE,
          (m) => `<span class="map-emoji">${m}</span>`,
        );
        textEl.classList.remove("hidden");
      } else {
        textEl.classList.add("hidden");
      }
    }

    function renderQuestion(question) {
      const nextButton = document.getElementById("next-button");
      document.getElementById("open-answer-input").value = "";
      const audioOnly = !!(question.audio_only && question.question_sound_url);
      showQuestionWords(question, audioOnly);

      const audioEl = document.getElementById("question-audio");
      // Audio is made on first request, so it can fail (no key, ElevenLabs down). A listening
      // question must not leave the learner with nothing to read: show its words instead.
      audioEl.onerror = audioOnly
        ? () => {
            if (currentQuestion === question) showQuestionWords(question, false);
          }
        : null;
      if (question.question_sound && question.question_sound_url) {
        audioEl.src = question.question_sound_url;
        audioEl.load();
        if (audioOnly) playQuestionAudio(true); // may be blocked until a tap; the big button replays
      } else {
        audioEl.removeAttribute("src");
      }

      const optionsContainer = document.getElementById("options-container");
      const openAnswerContainer = document.getElementById(
        "open-answer-container",
      );

      if (question.content_type === "open_answer") {
        optionsContainer.classList.add("hidden");
        openAnswerContainer.classList.remove("hidden");
        const input = document.getElementById("open-answer-input");
        input.oninput = (e) => {
          selectedAnswer = e.target.value.trim();
          nextButton.disabled = selectedAnswer.length === 0;
        };
      } else {
        openAnswerContainer.classList.add("hidden");
        optionsContainer.classList.remove("hidden");
        MCOptions.render(optionsContainer, question.options, (value) => {
          selectedAnswer = value;
          nextButton.disabled = false;
        });
      }
    }

    function loadNewMAPQuestion(payload = null) {
      const nextButton = document.getElementById("next-button");
      const quizInterface = document.getElementById("quiz-interface");
      const loading = document.getElementById("loading-indicator");

      if (!payload) {
        quizInterface.classList.add("hidden");
        loading.classList.remove("hidden");
      }

      nextButton.disabled = true;

      window.analytics.trackedFetch("{{ url_for('api.learner.api_map_question') }}", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: payload ? JSON.stringify(payload) : "{}",
      }, {
        flow: "map",
        action: payload ? "submit_answer" : "load_question",
      })
        .then((response) => response.json())
        .then((data) => {
          loading.classList.add("hidden");
          quizInterface.classList.remove("hidden");

          if (data.completed) {
            // The result is already saved; the hand-over gives it a moment to land. "Found your
            // place" only when there is a place to show.
            window.JourneyLoader.run(data, { done: data.recommended_start ? null : MAP_T.allDone }).then(() => {
              showCompletionState(data);
              window.JourneyLoader.hide();
            });
          } else {
            currentQuestion = data;
            selectedAnswer = null;
            renderQuestion(data);
          }
        })
        .catch((error) => {
          console.error("Error:", error);
          window.analytics?.trackError?.(error, {
            flow: "map",
            action: payload ? "submit_answer" : "load_question",
          });
          window.showToast(MAP_T.loadError, "error");
          setTimeout(() => loadNewMAPQuestion(payload), 3000);
        });
    }

    function showCompletionState(data) {
      document.getElementById("quiz-interface").classList.add("hidden");
      document.getElementById("completion-state").classList.remove("hidden");

      const rec = data && data.recommended_start;
      if (rec && rec.topic_url) {
        document.getElementById("recommendation-topic").textContent = rec.topic_title;
        document.getElementById("recommendation-course").textContent =
          MAP_T.recommendCourse.replace("{course}", rec.subject || "");
        document.getElementById("recommendation-section").classList.remove("hidden");

        // The topic card is now the primary action, so the dashboard link drops
        // back to the secondary outline variant (green = primary, one per screen).
        const dashLink = document.getElementById("dashboard-link");
        dashLink.classList.remove("btn-accent");
        dashLink.classList.add("btn-sky");

        const startBtn = document.getElementById("recommendation-start-btn");
        startBtn.href = rec.topic_url;
        startBtn.addEventListener("click", () => {
          window.analytics?.trackEvent?.("map_recommendation_clicked", {
            topic_id: rec.topic_id,
            topic_level: rec.topic_level,
            course_id: rec.subject_id,
            source: "map_complete",
          });
        });
      }
    }

    document.getElementById("next-button").addEventListener("click", () => {
      const nextButton = document.getElementById("next-button");
      if (nextButton.disabled) return;

      window.analytics?.trackEvent?.("cta_clicked", {
        action: "map_submit_answer",
      });
      const payload = {
        id: currentQuestion.id,
        selected_answer: selectedAnswer,
      };
      loadNewMAPQuestion(payload);
    });
  </script>
</Page>
