{#- One worksheet a teacher assigned to this learner: a header card with its subject, title and
    a "mark as done" button (or the completed pill), then the worksheet itself: the PDF embedded
    with a full-screen link (an open button stands in where the browser can't show PDFs inline),
    the rendered markdown, or a placeholder when there is no content. -#}
{#import "@components/shell/page.jx" as Page #}
{#import "@components/worksheet_prose.jx" as WorksheetProse #}
{#import "@components/base/icon.jx" as Icon #}
{#import "@components/shell/main.jx" as Main #}
{#def assignment, worksheet_html #}
{%- set worksheet = assignment.worksheet %}
<Page title={{ worksheet.title ~ " - IntegratED" }} styles="learning-nav">
  <Main width="3xl">

    <div class="mb-6">
      <a href="{{ url_for('learner.learner_dashboard') }}" class="breadcrumb-link">
        <Icon name="chevron-left" />
        {{ t('learner.worksheet_view.back_to_dashboard') }}
      </a>
    </div>

    <div class="wv-card mb-6">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-2 flex-wrap">
            <span class="text-xs font-bold text-sky-500 uppercase tracking-widest bg-sky-50 border border-primary-soft rounded-full px-3 py-0.5">{{ worksheet.subject }}</span>
            {%- if worksheet.topic %}
            <span class="text-xs text-sky-300">&bull;</span>
            <span class="text-xs font-semibold text-sky-400">{{ worksheet.topic }}</span>
            {%- endif %}
          </div>
          <h1 class="display-font text-2xl md:text-3xl font-extrabold text-sky-950 leading-tight">{{ worksheet.title }}</h1>
          <p class="text-sm text-sky-300 mt-2 font-medium">{{ t('learner.worksheet_view.assigned_on') }} {{ assignment.assigned_at.strftime('%Y-%m-%d') }}</p>
        </div>

        <div class="flex-shrink-0">
          {%- if assignment.completed %}
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-green-50 border-2 border-[var(--color-card-green-border)] text-accent-dark text-sm font-bold shadow-[2px_2px_0_var(--color-card-green-shadow)]">
            <Icon name="check" />
            {{ t('learner.worksheet_view.completed') }}
          </span>
          {%- else %}
          <form method="post" action="{{ url_for('learner.learner_complete_worksheet', assignment_id=assignment.id) }}">
            <button type="submit" class="wv-btn-accent">
              <Icon name="check" />
              {{ t('learner.worksheet_view.mark_as_done') }}
            </button>
          </form>
          {%- endif %}
        </div>
      </div>
    </div>

    {%- if worksheet.file_type == 'pdf' %}
    {%- set pdf_url = url_for('learner.learner_worksheet_file', assignment_id=assignment.id) %}
    <div class="wv-card wv-card-flush">
      <object data="{{ pdf_url }}#view=FitH" type="application/pdf" aria-label="{{ worksheet.title }}" class="block w-full h-[75vh] bg-sky-50">
        <div class="text-center py-12 px-6">
          <div class="w-16 h-16 mx-auto rounded-2xl bg-sky-50 border-2 border-primary-light flex items-center justify-center mb-4 shadow-[3px_3px_0_var(--color-sky-200)]">
            <Icon name="document" size="8" class="text-sky-500" />
          </div>
          <p class="text-sky-400 text-sm mb-6 font-medium">{{ t('learner.worksheet_view.pdf_note') }}</p>
          <a href="{{ pdf_url }}" target="_blank" class="wv-btn-accent">
            <Icon name="arrow-top-right-on-square" />
            {{ t('learner.worksheet_view.open_pdf') }}
          </a>
        </div>
      </object>
      <div class="flex items-center justify-end gap-3 px-4 py-3 border-t-2 border-sky-100 bg-white">
        <a href="{{ pdf_url }}" target="_blank" class="inline-flex items-center gap-2 text-sm font-bold text-sky-600 hover:text-sky-800">
          <Icon name="arrow-top-right-on-square" />
          {{ t('learner.worksheet_view.open_full_screen') }}
        </a>
      </div>
    </div>

    {%- elif worksheet_html %}
    <WorksheetProse tag="article" class="wv-card prose prose-sm max-w-none prose-headings:font-bold prose-headings:text-sky-950 prose-p:leading-relaxed prose-li:leading-relaxed prose-table:rounded-xl prose-th:bg-sky-50">
      {{ worksheet_html | safe }}
    </WorksheetProse>

    {%- else %}
    <div class="wv-card text-center py-12">
      <div class="w-16 h-16 mx-auto rounded-2xl bg-sky-50 border-2 border-dashed border-primary-light flex items-center justify-center mb-4">
        <Icon name="document-text" size="8" class="text-sky-300" />
      </div>
      <p class="text-sky-300 text-sm font-medium">{{ t('learner.worksheet_view.content_unavailable') }}</p>
    </div>
    {%- endif %}

  </Main>
</Page>
