326.3 594.2 330.6 598.9ZM333.5 598.1Q332.5 589.7 330.3 581.3Q327.8 589.9 330.4 598.2ZM333.3 598.9Q338.1 594 338.6 586.9Q334 591.9 330.6 597.5ZM468.5 596.6Q467.3 592 463.9 588.4Q464.1 593.3 466.3 597.4ZM468.6 597Q469 590.6 467.5 584.2Q465.5 590.6 466.3 597ZM468.4 597.6Q471.2 593.6 472.5 588.5Q468.3 591.7 466.4 596.4ZM186.2 592.8Q183.3 588.5 179 585.1Q180.1 590.7 184.1 594.2ZM186.4 593.5Q187.8 586.4 185.8 579.2Q183.9 586.3 183.8 593.5ZM186.3 594Q189.5 589.4 189.8 583.5Q185.9 587.8 184 593ZM160.2 598.7Q157.8 593.8 153.5 590.1Q154.3 595.8 157.8 600ZM160.3 599.4Q161.3 592.1 159.8 584.6Q157.3 591.8 157.7 599.2ZM160.2 599.9Q163.8 595.2 163.9 589Q160.1 593.6 157.8 598.8ZM338 590.5Q336.5 583.2 330.9 577.8Q331.6 585.4 334.7 591.9ZM338.1 591.3Q338.9 581.4 336.9 571.3Q333.5 581.1 334.5 591.1ZM338 591.9Q340.6 584.7 341.7 576.8Q335.7 582.5 334.7 590.5ZM438.2 590.2Q435.5 584.9 431.4 580.4Q431.5 586.8 435.5 591.4ZM438.3 590.9Q439.9 582.9 438.4 574.6Q435.5 582.5 435.4 590.7ZM438.2 591.4Q442 586.2 442.1 579.4Q438 584.5 435.5 590.2ZM365.7 588.1Q363.1 582.3 358.3 577.6Q358.8 584.4 362.9 589.5ZM365.9 588.6Q367.2 579.8 363.6 571.3Q362.4 580.1 362.7 588.9ZM365.8 589.4Q368.4 583.2 369 576.1Q364 581.4 362.8 588.2ZM190.9 593Q187.2 588 182.2 583.9Q183.4 590.5 188.3 594.7ZM191.1 593.6Q191.5 585 187.7 576.9Q186.9 585.6 188 594.1ZM190.9 594.6Q195.5 589.6 196.4 582.6Q191.5 587.4 188.2 593.1Z" fill="#1C4436"/><defs><radialGradient id="ggn-fly"><stop offset="0" stop-color="#FFE98A" stop-opacity="0.9"/><stop offset="1" stop-color="#FFE98A" stop-opacity="0"/></radialGradient></defs><rect width="600" height="600" fill="#0B1B3A" opacity="0.22"/><g class="gg-firefly" style="--gg-ff-d:6.4s;--gg-ff-delay:4.2s"><circle cx="407.3" cy="515.3" r="7" fill="url(#ggn-fly)"/><circle cx="407.3" cy="515.3" r="1.8" fill="#FFF6B0"/></g><g class="gg-firefly" style="--gg-ff-d:8.9s;--gg-ff-delay:4.8s"><circle cx="464.1" cy="479" r="7" fill="url(#ggn-fly)"/><circle cx="464.1" cy="479" r="1.8" fill="#FFF6B0"/></g><g class="gg-firefly" style="--gg-ff-d:5.7s;--gg-ff-delay:4.2s"><circle cx="312.8" cy="437.6" r="7" fill="url(#ggn-fly)"/><circle cx="312.8" cy="437.6" r="1.8" fill="#FFF6B0"/></g><g class="gg-firefly" style="--gg-ff-d:7.8s;--gg-ff-delay:3.6s"><circle cx="493.1" cy="424.1" r="7" fill="url(#ggn-fly)"/><circle cx="493.1" cy="424.1" r="1.8" fill="#FFF6B0"/></g><g class="gg-firefly" style="--gg-ff-d:8.1s;--gg-ff-delay:2.9s"><circle cx="404.1" cy="344.7" r="7" fill="url(#ggn-fly)"/><circle cx="404.1" cy="344.7" r="1.8" fill="#FFF6B0"/></g><g class="gg-firefly" style="--gg-ff-d:7.5s;--gg-ff-delay:3.9s"><circle cx="376.2" cy="409.4" r="7" fill="url(#ggn-fly)"/><circle cx="376.2" cy="409.4" r="1.8" fill="#FFF6B0"/></g><g class="gg-firefly" style="--gg-ff-d:5.1s;--gg-ff-delay:0.8s"><circle cx="363.9" cy="487.3" r="7" fill="url(#ggn-fly)"/><circle cx="363.9" cy="487.3" r="1.8" fill="#FFF6B0"/></g><g class="gg-firefly" style="--gg-ff-d:5.9s;--gg-ff-delay:3.4s"><circle cx="279.7" cy="469" r="7" fill="url(#ggn-fly)"/><circle cx="279.7" cy="469" r="1.8" fill="#FFF6B0"/></g><g class="gg-firefly" style="--gg-ff-d:6.9s;--gg-ff-delay:1.1s"><circle cx="361.3" cy="310.9" r="7" fill="url(#ggn-fly)"/><circle cx="361.3" cy="310.9" r="1.8" fill="#FFF6B0"/></g><g class="gg-firefly" style="--gg-ff-d:6.3s;--gg-ff-delay:0.9s"><circle cx="113.3" cy="334.7" r="7" fill="url(#ggn-fly)"/><circle cx="113.3" cy="334.7" r="1.8" fill="#FFF6B0"/></g><g class="gg-firefly" style="--gg-ff-d:6.9s;--gg-ff-delay:1.9s"><circle cx="173.1" cy="309.3" r="7" fill="url(#ggn-fly)"/><circle cx="173.1" cy="309.3" r="1.8" fill="#FFF6B0"/></g><g class="gg-firefly" style="--gg-ff-d:6s;--gg-ff-delay:4.5s"><circle cx="353.1" cy="453.4" r="7" fill="url(#ggn-fly)"/><circle cx="353.1" cy="453.4" r="1.8" fill="#FFF6B0"/></g><g class="gg-firefly" style="--gg-ff-d:6.1s;--gg-ff-delay:2.1s"><circle cx="90.3" cy="405.4" r="7" fill="url(#ggn-fly)"/><circle cx="90.3" cy="405.4" r="1.8" fill="#FFF6B0"/></g><g class="gg-firefly" style="--gg-ff-d:6.5s;--gg-ff-delay:0.2s"><circle cx="139.5" cy="516.2" r="7" fill="url(#ggn-fly)"/><circle cx="139.5" cy="516.2" r="1.8" fill="#FFF6B0"/></g></svg>
        {% endif %}
      </div>
        <svg class="gg-plants" id="gardenPlants" viewBox="0 0 600 600" preserveAspectRatio="xMidYMax slice" aria-hidden="true"></svg>
        <div class="gg-storm-veil" aria-hidden="true"></div>
        <svg class="gg-raincloud" viewBox="0 0 400 120" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 0 H400 V64 C380 86 352 92 330 80 C316 102 280 108 258 90 C240 110 200 112 182 92 C164 108 128 106 116 86 C96 100 62 98 52 78 C34 90 10 86 0 72 Z" fill="#5E6B86"/>
          <path d="M0 0 H400 V48 C380 68 352 72 330 62 C316 82 280 88 258 72 C240 90 200 92 182 74 C164 88 128 86 116 68 C96 80 62 78 52 60 C34 70 10 66 0 54 Z" fill="#76839E"/>
          <path d="M0 0 H400 V30 C372 44 340 40 320 34 C296 48 252 46 236 36 C210 50 170 48 150 38 C124 50 84 46 64 36 C40 44 14 40 0 32 Z" fill="#8F9BB4"/>
        </svg>
        <p id="sceneStatus" class="sr-only" aria-live="polite"></p>
      </div>
      <p class="gg-saved-note">{{ t('learner.garden_grow.saved_note') }}</p>
    </section>
  </main>

  <div class="game-hint-toast" id="tryAgain">{{ t('learner.garden_grow.try_again') }}</div>

<script>
// ============================================================
// Garden Grow — answer to earn a water drop, then choose: plant a
// seed in the next empty spot, or make it rain so every plant grows
// a stage. Rain on a fully grown plant drops a golden grain (bonus
// XP, capped server-side). The garden persists (POST /api/garden).
// ============================================================
const lessonId = {{ lesson.id }};
GameKit.init({ lessonId, game: 'garden_grow' });
const initialGarden = {{ (current_user.garden_state or {}) | tojson }};

// GARDEN_PLOTS (helpers/learning/_games.py), passed in by the route.
const N_PLOTS = {{ garden_plots | tojson }};
const FLOWER_COLORS = ["#FB7185", "#FCD34D", "#38BDF8", "#A78BFA", "#FB923C", "#F472B6", "#34D399", "#F87171"];
const T = {
  questionOf: {{ t('learner.garden_grow.question_of') | tojson }},
  allDone:    {{ t('learner.garden_grow.all_done') | tojson }},
  streak:     {{ t('learner.garden_grow.streak') | tojson }},
  sceneStatus:{{ t('learner.garden_grow.scene_status') | tojson }},
  checkFailed:{{ t('learner.game.check_failed') | tojson }},
};
const LETTERS = ["A", "B", "C", "D", "E", "F"];
// One shape per answer slot, so the letter is never the only cue.
const LETTER_SHAPES = [
  '<circle class="gg-shape" cx="20" cy="20" r="18"/>',
  '<path class="gg-shape" d="M20 2.5 L38 35.5 H2Z" stroke-linejoin="round"/>',
  '<rect class="gg-shape" x="3" y="3" width="34" height="34" rx="7"/>',
  '<path class="gg-shape" d="M20 1 L39 20 L20 39 L1 20Z"/>',
  '<path class="gg-shape" d="M11 3 H29 L39 20 L29 37 H11 L1 20Z"/>',
  '<path class="gg-shape" d="M20 1 L25 14 L39 14.5 L28 23.5 L32 38 L20 30 L8 38 L12 23.5 L1 14.5 L15 14Z"/>',
];
const LETTER_Y = [25.5, 31, 25.5, 25.5, 25.5, 27];
const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

let garden = normalizeGarden(initialGarden);
let questions = [];
let qi = 0;
let firstTry = true;
let grains = 0;     // grains harvested this play (bonus XP, server-capped)
let streak = 0;
let mode = "loading"; // loading | question | spend | busy | done

// Flying bits (the earned drop, the seed packet, a grain) are positioned in
// *page* coordinates on <body>, read once when an animation starts, so they
// still land in the right place if the learner scrolls mid-flight.
function pageRect(el) {
  const r = el.getBoundingClientRect();
  return { left: r.left + window.scrollX, top: r.top + window.scrollY, width: r.width, height: r.height };
}
// A point in the plants SVG's 600×600 user space, in page coordinates.
const plantsSvg = document.getElementById("gardenPlants");
function scenePoint(x, y) {
  const p = plantsSvg.createSVGPoint();
  p.x = x; p.y = y;
  const s = p.matrixTransform(plantsSvg.getScreenCTM());
  return { x: s.x + window.scrollX, y: s.y + window.scrollY };
}

document.getElementById("speakerBtn").addEventListener("click", () => GameKit.speakQuestion(questions[qi]));

// ── Garden state (shape validated again by POST /api/garden) ────────────
function normalizeGarden(g) {
  const stages = Array.isArray(g && g.stages) ? g.stages.slice(0, N_PLOTS) : [];
  const colors = Array.isArray(g && g.colors) ? g.colors.slice(0, N_PLOTS) : [];
  while (stages.length < N_PLOTS) stages.push(0);
  while (colors.length < N_PLOTS) colors.push(null);
  return {
    stages: stages.map(s => Math.min(3, Math.max(0, parseInt(s, 10) || 0))),
    colors: colors.map(c => (typeof c === "string" && /^#[0-9A-Fa-f]{6}$/.test(c)) ? c : null),
  };
}
function saveGarden() {
  window.analytics.trackedFetch("/api/garden", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ garden: garden }),
  }).catch(() => {});
}

// ════════════════════════════════════════════════════════════════════════
// The plants. Each species is drawn ONCE at full size with its base at the
// local origin, growing up (−y). Every leaf, frond and fruit is a part
// tagged with the stage it appears at (data-s). Growing is CSS only: the
// whole plant scales up around its base, and the new stage's parts unfurl
// from their own attach point (an SVG <g>'s transform-origin is its local
// 0,0, which is exactly where each part is attached). Cheap on old phones.
// ════════════════════════════════════════════════════════════════════════
// Each species has its own palette AND its own silhouette, so plants are told
// apart at a glance: lime paddles (banana), blue-teal feathers (palm), deep
// emerald split hearts (monstera), one tall stalk with a big flower (bloom).
const C = { soil: "#5B3C24", soilHi: "#7B5534" };
const P = {
  banana:   { hi: "#CBE86B", leaf: "#A6D23F", mid: "#82B22E", rib: "#EEF7B4", trunk: "#A9C34E", trunkShade: "#83A03A", sheath: "#A0473A", sheathShade: "#7A3830" },
  palm:     { hi: "#5DB894", leaf: "#349476", dark: "#1F6A52", rib: "#2A7A5F", trunk: "#B38A5E", trunkShade: "#8E6A45", ring: "#6E4F33" },
  monstera: { leaf: "#2E8B45", mid: "#22703A", rib: "#86C895", hole: "#164A28", stalk: "#2A7A40" },
  bloom:    { stem: "#4E8F2E", leaf: "#6FB43A", mid: "#558F2B", center: "#6B3E1F", centerHi: "#8A5530" },
};
const f = n => +n.toFixed(1);
// A part: an outer <g> placed at its attach point, an inner .gg-part that scales/unfurls.
function part(s, x, y, rot, inner, delay = 0, extra = "") {
  return `<g transform="translate(${f(x)} ${f(y)}) rotate(${f(rot)})${extra}"><g class="gg-part" data-s="${s}" style="--d:${delay}s">${inner}</g></g>`;
}

// Banana tree — the hero, as in the reference clearing: a stout trunk, broad lime
// paddle leaves from a crown, and a hanging bunch with its purple bud at stage 3.
function bananaLeaf(L, w) {
  const c = P.banana;
  return `<path d="M0 0 C${f(L*.22)} ${f(-w*1.25)} ${f(L*.74)} ${f(-w*1.15)} ${f(L)} ${f(w*.42)} Q${f(L*.5)} ${f(-w*.32)} 0 0Z" fill="${c.leaf}"/>
    <path d="M0 0 Q${f(L*.5)} ${f(-w*.32)} ${f(L)} ${f(w*.42)} C${f(L*.76)} ${f(w*.95)} ${f(L*.26)} ${f(w*.86)} 0 0Z" fill="${c.mid}"/>
    <path d="M${f(L*.46)} ${f(-w*.86)} l${f(L*.04)} ${f(w*.5)} M${f(L*.66)} ${f(-w*.66)} l${f(L*.03)} ${f(w*.42)}" stroke="${c.hi}" stroke-width="2.2" stroke-linecap="round"/>
    <path d="M0 0 Q${f(L*.5)} ${f(-w*.32)} ${f(L)} ${f(w*.42)}" fill="none" stroke="${c.rib}" stroke-width="2.6" stroke-linecap="round"/>`;
}
function banana() {
  const c = P.banana, H = 140;
  const trunk = `<path d="M-14 0 C-13 -60 -10 -105 -8 -${H} H8 C10 -105 13 -60 14 0Z" fill="${c.trunk}"/>
    <path d="M4 0 C5 -60 6 -105 8 -${H} H8 C10 -105 13 -60 14 0Z" fill="${c.trunkShade}"/>
    <path d="M-7 -40 C-5 -70 -4 -100 -3 -125 M1 -20 C2 -60 3 -100 3 -132" stroke="${c.hi}" stroke-width="2" stroke-linecap="round" fill="none" opacity=".6"/>
    <path d="M-17 0 C-17 -14 -14 -30 -7 -44 C-5 -30 -2 -16 0 0Z M17 0 C17 -16 12 -34 5 -50 C4 -32 2 -14 0 0Z M-4 0 C-6 -14 -2 -30 2 -38 C4 -24 4 -12 4 0Z" fill="${c.sheath}"/>
    <path d="M17 0 C17 -16 12 -34 5 -50 C7 -30 8 -14 7 0Z" fill="${c.sheathShade}"/>`;
  // [stage, angle (0 = pointing right, -90 = up), length, width]
  const leaves = [
    [1, -106, 72, 20], [1, -72, 66, 19],
    [2, -144, 96, 25], [2, -36, 100, 25], [2, -90, 84, 22],
    [3, -170, 116, 27], [3, -10, 118, 27], [3, -124, 108, 26], [3, -56, 110, 26],
  ];
  let out = trunk;
  leaves.forEach(([s, a, L, w], k) => {
    out += part(s, 0, -H, a, bananaLeaf(L, w), 0.06 * k, Math.abs(a) > 90 ? " scale(1 -1)" : "");
  });
  const fingers = [];
  for (let r = 0; r < 4; r++) for (let k = 0; k < 4 - (r > 2 ? 1 : 0); k++) {
    fingers.push(`<path d="M${-9 + k * 6} ${r * 9} q-3 -6 2 -12" stroke="${r % 2 ? "#E8B92C" : "#F5CB3A"}" stroke-width="6" stroke-linecap="round" fill="none"/>`);
  }
  const bunch = `<path d="M0 -6 C2 6 3 20 2 40" stroke="${c.trunkShade}" stroke-width="3.5" fill="none"/>${fingers.join("")}
    <path d="M2 40 C9 46 9 58 2 66 C-5 58 -5 46 2 40Z" fill="#7A2E55"/><path d="M2 40 C9 46 9 58 2 66 C4 56 4 48 2 40Z" fill="#5C1F40"/>`;
  out += part(3, 6, -H + 12, 0, `<g transform="translate(4 8)">${bunch}</g>`, 0.6);
  return out;
}

// Coconut palm — tall, thin and leaning, with drooping blue-teal fronds built leaflet by leaflet.
function frond(L) {
  const c = P.palm;
  let s = "";
  const n = 14;
  for (let k = 1; k <= n; k++) {
    const t = k / (n + 1), x = L * t, y = L * 0.34 * t * t;           // midrib droops
    const len = (1 - t * 0.55) * L * 0.3;
    const up = `M${f(x)} ${f(y)} q${f(len * .25)} ${f(-len * .55)} ${f(len * .55)} ${f(-len * .9)} q${f(-len * .1)} ${f(len * .5)} ${f(-len * .38)} ${f(len * .92)}Z`;
    const dn = `M${f(x)} ${f(y)} q${f(len * .3)} ${f(len * .5)} ${f(len * .6)} ${f(len * .8)} q${f(-len * .12)} ${f(-len * .5)} ${f(-len * .45)} ${f(-len * .82)}Z`;
    s += `<path d="${dn}" fill="${c.dark}"/><path d="${up}" fill="${k % 2 ? c.leaf : c.hi}"/>`;
  }
  return s + `<path d="M0 0 Q${f(L * .5)} ${f(L * .02)} ${f(L)} ${f(L * .34)}" fill="none" stroke="${c.rib}" stroke-width="3" stroke-linecap="round"/>`;
}
function palm() {
  const c = P.palm, top = { x: 34, y: -226 };
  let trunk = `<path d="M-9 0 C-5 -80 8 -160 ${top.x - 5} ${top.y} H${top.x + 5} C16 -160 4 -80 9 0Z" fill="${c.trunk}"/>
    <path d="M3 0 C2 -80 13 -160 ${top.x + 1} ${top.y} H${top.x + 5} C16 -160 4 -80 9 0Z" fill="${c.trunkShade}"/>`;
  for (let k = 1; k < 14; k++) {
    const t = k / 14, y = -t * 226, x = -9 + (top.x + 4) * Math.pow(t, 1.7);
    trunk += `<path d="M${f(x)} ${f(y)} q${f(8 - t * 2)} ${f(3.5)} ${f(17 - t * 6)} 0" stroke="${c.ring}" stroke-width="2.2" fill="none" stroke-linecap="round" opacity=".7"/>`;
  }
  const fronds = [
    [1, -102, 62], [1, -62, 58],
    [2, -154, 90], [2, -26, 94], [2, -120, 78],
    [3, -184, 110], [3, 4, 112], [3, -146, 100], [3, -44, 102],
  ];
  let out = trunk;
  fronds.forEach(([s, a, L], k) => {
    out += part(s, top.x, top.y, a, frond(L), 0.06 * k, Math.abs(a) > 90 ? " scale(1 -1)" : "");
  });
  const nuts = `<circle cx="-8" cy="6" r="9" fill="#7A5232"/><circle cx="7" cy="8" r="9.5" fill="#6A4529"/><circle cx="0" cy="-3" r="8.5" fill="#8A6038"/>
    <circle cx="-10" cy="3" r="2.6" fill="#B08560"/><circle cx="-2" cy="-6" r="2.2" fill="#B08560"/>`;
  out += part(3, top.x, top.y + 6, 0, nuts, 0.55);
  return out;
}

// Monstera — a low, wide bush of deep emerald split leaves on arching stalks,
// with cream flowers tipped in the plot's colour at stage 3. A mound, never a tree.
function monsteraLeaf() {
  const c = P.monstera;
  return `<path d="M0 0 C-22 4 -52 -10 -56 -42 C-60 -74 -32 -100 0 -102 C34 -100 60 -74 56 -42 C52 -10 22 4 0 0Z" fill="${c.leaf}"/>
    <path d="M0 0 C22 4 52 -10 56 -42 C60 -74 34 -100 0 -102 C8 -70 8 -30 0 0Z" fill="${c.mid}"/>
    <path d="M-30 -86 C-20 -94 -8 -96 0 -96" stroke="#FFFFFF" stroke-width="3" fill="none" stroke-linecap="round" opacity=".25"/>
    <path d="M0 -2 Q3 -50 0 -98" stroke="${c.rib}" stroke-width="2.4" fill="none"/>
    <g fill="${c.hole}">
      <path d="M-57 -30 L-28 -37 L-56 -40Z"/><path d="M-52 -62 L-24 -59 L-54 -70Z"/><path d="M56 -34 L26 -41 L55 -44Z"/><path d="M49 -66 L21 -62 L51 -74Z"/>
      <ellipse cx="-20" cy="-22" rx="4" ry="5.5"/><ellipse cx="22" cy="-80" rx="3.5" ry="5"/>
    </g>`;
}
function monstera(color) {
  const c = P.monstera;
  // [stage, stalk end x, y, leaf angle, scale]
  const leaves = [
    [1, -16, -40, -22, .52], [1, 18, -44, 20, .5],
    [2, -54, -52, -48, .74], [2, 54, -56, 44, .76], [2, 0, -76, 0, .72],
    [3, -84, -30, -74, .78], [3, 86, -32, 72, .8], [3, -30, -84, -18, .7], [3, 32, -86, 20, .7],
  ];
  let out = "";
  leaves.forEach(([s, x, y, a, sc], k) => {
    const stalk = `<path d="M0 0 Q${f(x * .2)} ${f(y * .8)} ${f(x)} ${f(y)}" stroke="${c.stalk}" stroke-width="4" fill="none" stroke-linecap="round"/>`;
    out += `<g><g class="gg-part" data-s="${s}" style="--d:${0.07 * k}s">${stalk}<g transform="translate(${x} ${y}) rotate(${a}) scale(${sc})">${monsteraLeaf()}</g></g></g>`;
  });
  const flower = (x, y, r) => part(3, x, y, r, `<path d="M0 0 C-14 -10 -14 -34 0 -46 C14 -34 14 -10 0 0Z" fill="#FFF6DD"/>
    <path d="M0 0 C10 -10 10 -34 0 -46 C4 -30 4 -14 0 0Z" fill="#E9DDB8"/>
    <path d="M0 -6 C3 -18 3 -28 0 -36" stroke="${color}" stroke-width="6" stroke-linecap="round" fill="none"/>`, 0.6);
  return out + flower(-22, -60, -18) + flower(26, -64, 16);
}

// Bloom — one tall stalk with heart leaves; a bud at stage 2 that opens into a
// big two-ring flower in the plot's colour at stage 3. The tallest thin shape.
function heartLeaf() {
  const c = P.bloom;
  return `<path d="M0 0 C8 -4 26 -2 34 -14 C40 -24 30 -34 22 -28 C18 -36 6 -34 6 -22 C6 -14 4 -6 0 0Z" fill="${c.leaf}"/>
    <path d="M0 0 C8 -4 26 -2 34 -14 C24 -12 12 -8 0 0Z" fill="${c.mid}"/>`;
}
function bloom(color) {
  const c = P.bloom, H = 170;
  let out = part(1, 0, 0, 0, `<path d="M0 0 C-4 -50 4 -110 0 -${H}" stroke="${c.stem}" stroke-width="6" fill="none" stroke-linecap="round"/>`);
  [[1, -18, 0], [1, -34, 1], [2, -66, 0], [2, -92, 1], [3, -122, 0], [3, -140, 1]].forEach(([s, y, side], k) => {
    out += part(s, 0, y, side ? -18 : 18, heartLeaf(), 0.06 * k, side ? " scale(-1 1)" : "");
  });
  // Stage 2 only: a closed bud showing a sliver of colour (the open flower replaces it).
  out += `<g transform="translate(0 -${H})"><g class="gg-part gg-bud" data-s="2" style="--d:0.3s">
    <path d="M0 0 C-12 -6 -12 -26 0 -34 C12 -26 12 -6 0 0Z" fill="${c.leaf}"/><path d="M-3 -10 C-4 -20 -2 -28 0 -32 C4 -24 4 -14 3 -10Z" fill="${color}"/></g></g>`;
  // Stage 3: the open flower — two rings of petals and a seed centre.
  let petals = "";
  for (let k = 0; k < 12; k++) petals += `<ellipse transform="rotate(${k * 30})" cx="0" cy="-28" rx="9" ry="20" fill="${color}"/>`;
  for (let k = 0; k < 12; k++) petals += `<ellipse transform="rotate(${k * 30 + 15})" cx="0" cy="-20" rx="7" ry="14" fill="${color}"/><ellipse transform="rotate(${k * 30 + 15})" cx="0" cy="-20" rx="7" ry="14" fill="#000" opacity=".1"/>`;
  out += part(3, 0, -H - 14, 0, `${petals}<circle r="15" fill="${c.center}"/><circle cx="-4" cy="-4" r="7" fill="${c.centerHi}"/>
    <g fill="#E9B44C"><circle cx="5" cy="3" r="1.6"/><circle cx="-2" cy="7" r="1.6"/><circle cx="8" cy="-5" r="1.4"/></g>`, 0.5);
  return out;
}

const SPECIES = { banana, palm, monstera, bloom };
// Where each plot sits in the 600×600 clearing and what grows there — all on the
// clearing floor (y ≥ 496), below the treeline, so nothing stands on the horizon.
// Plot 0 is the first planted: the banana tree, centre stage, the clearing's hero.
const SPOTS = [
  { x: 292, y: 520, s: 1.0,  sp: "banana" },
  { x: 160, y: 562, s: 0.95, sp: "bloom" },
  { x: 425, y: 512, s: 0.95, sp: "palm" },
  { x: 430, y: 580, s: 0.95, sp: "monstera" },
  { x: 168, y: 500, s: 0.78, sp: "palm", flip: true },
  { x: 300, y: 590, s: 0.8,  sp: "monstera", flip: true },
  { x: 388, y: 498, s: 0.74, sp: "banana", flip: true },
  { x: 230, y: 540, s: 0.85, sp: "bloom", flip: true },
];
const STAGE_SCALE = [0, 0.5, 0.76, 1];

const plotEls = [];
function buildGarden() {
  // Paint back to front so nearer plants overlap farther ones.
  const order = SPOTS.map((s, i) => i).sort((a, b) => SPOTS[a].y - SPOTS[b].y);
  let html = "";
  order.forEach(i => {
    const s = SPOTS[i];
    html += `<g class="gg-plot" data-i="${i}" transform="translate(${s.x} ${s.y}) scale(${s.flip ? -s.s : s.s} ${s.s})">
      <ellipse class="gg-mound" cx="0" cy="2" rx="30" ry="9" fill="${C.soil}"/>
      <ellipse class="gg-mound" cx="-3" cy="0" rx="24" ry="6" fill="${C.soilHi}"/>
      <ellipse class="gg-target" cx="0" cy="2" rx="40" ry="14" fill="none" stroke="#FFFFFF" stroke-width="4" stroke-dasharray="8 7"/>
      <g class="gg-grow"><g class="gg-sway" style="--sw:${(5 + (i % 3) * 1.3).toFixed(1)}s;--sw-d:${(-i * 0.7).toFixed(1)}s"></g></g>
    </g>`;
  });
  plantsSvg.innerHTML = html;
  plantsSvg.querySelectorAll(".gg-plot").forEach(el => { plotEls[+el.dataset.i] = el; });
  for (let i = 0; i < N_PLOTS; i++) renderPlot(i, false);
}

function renderPlot(i, animate) {
  const stage = garden.stages[i];
  const plot = plotEls[i];
  const sway = plot.querySelector(".gg-sway");
  const grow = plot.querySelector(".gg-grow");
  plot.classList.toggle("is-empty", stage === 0);
  if (stage === 0) { sway.innerHTML = ""; grow.style.transform = "scale(0)"; return; }
  if (!sway.innerHTML) {
    if (!garden.colors[i]) garden.colors[i] = FLOWER_COLORS[Math.floor(Math.random() * FLOWER_COLORS.length)];
    sway.innerHTML = SPECIES[SPOTS[i].sp](garden.colors[i]);
  }
  plot.classList.toggle("animate", !!animate && !reduceMotion);
  // Force the "before" state to paint, so a fresh seedling grows from the soil.
  if (animate && !reduceMotion && grow.style.transform === "scale(0)") void grow.getBoundingClientRect();
  grow.style.transform = `scale(${STAGE_SCALE[stage]})`;
  sway.querySelectorAll(".gg-part").forEach(p => p.classList.toggle("on", +p.dataset.s <= stage));
  plot.classList.toggle("is-ripe", stage === 3);
}

function updateSceneStatus() {
  const planted = garden.stages.filter(s => s > 0).length;
  const ripe = garden.stages.filter(s => s === 3).length;
  document.getElementById("sceneStatus").textContent =
    T.sceneStatus.replace("{planted}", planted).replace("{total}", N_PLOTS).replace("{ripe}", ripe);
}

// ── Load questions (the lesson's deal: its questions with options; resume via correct_ids) ──
async function loadQuestions() {
  const data = await GameKit.questions();
  questions = data ? data.questions : [];
  if (!questions.length) { showError(); return; }
  const correctIds = new Set(data.progress.correct_ids);
  qi = questions.findIndex(q => !correctIds.has(q.id));
  if (qi === -1) qi = questions.length;
  if (qi >= questions.length) { finishGame(); return; }
  renderQuestion();
}
function showError() {
  document.getElementById("errorState").classList.remove("hidden");
  document.getElementById("questionWrap").hidden = true;
  document.getElementById("spendWrap").hidden = true;
}

// ── Question flow ───────────────────────────────────────────────────────
function updateProgress() {
  GameKit.progress({
    label: qi >= questions.length ? T.allDone : T.questionOf.replace("{current}", qi + 1).replace("{total}", questions.length),
    fraction: Math.min(qi, questions.length) / questions.length,
  });
  // Garden's streak note fades with a class rather than [hidden], so it stays its own.
  const note = document.getElementById("streakNote");
  note.textContent = T.streak.replace("{n}", streak);
  note.classList.toggle("on", streak >= 2);
}

function renderQuestion() {
  mode = "question";
  firstTry = true;
  const Q = questions[qi];
  document.getElementById("questionWrap").hidden = false;
  document.getElementById("spendWrap").hidden = true;
  document.getElementById("questionText").textContent = Q.question_text || Q.question_prompt || "";
  updateProgress();

  const list = document.getElementById("answerList");
  list.innerHTML = "";
  GameKit.shuffle(Q.options).forEach((word, k) => {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "quick-action-card gg-answer";
    btn.setAttribute("aria-label", LETTERS[k % 6] + ": " + word);
    btn.innerHTML = `<span class="gg-letter gg-letter-${k % 6}" aria-hidden="true"><svg viewBox="0 0 40 40">${LETTER_SHAPES[k % 6]}<text x="20" y="${LETTER_Y[k % 6]}" text-anchor="middle">${LETTERS[k % 6]}</text></svg></span><span class="gg-answer-word"></span>`;
    btn.querySelector(".gg-answer-word").textContent = word;
    btn.addEventListener("click", () => onAnswer(word, btn));
    list.appendChild(btn);
  });
  if (!reduceMotion) gsap.from(list.children, { y: 16, opacity: 0, stagger: 0.06, duration: 0.32, ease: "back.out(1.6)", clearProps: "transform,translate,opacity" });
}

async function onAnswer(word, btn) {
  if (mode !== "question") return;
  const Q = questions[qi];
  mode = "busy";
  const isCorrect = await GameKit.check(Q.id, word);
  if (isCorrect === null) {
    // The check never reached the server: the answer stays tappable, just ask again.
    showHint(T.checkFailed);
    mode = "question";
    return;
  }
  GameKit.track('game_answer', { question_id: Q.id, is_correct: isCorrect, first_try: firstTry });

  if (!isCorrect) {
    firstTry = false;
    streak = 0;
    updateProgress();
    btn.classList.add("is-wrong");
    btn.disabled = true;
    if (!reduceMotion) gsap.fromTo(btn, { x: 0 }, { x: 6, duration: 0.06, repeat: 5, yoyo: true, ease: "power1.inOut", clearProps: "transform,translate" });
    showHint();
    mode = "question";
    return;
  }
  if (firstTry) { streak++; } else { streak = 0; }
  updateProgress();
  btn.classList.add("is-correct");
  document.querySelectorAll("#answerList button").forEach(b => { b.disabled = true; });
  GameKit.speak(word);
  earnDrop(btn);
}

function earnDrop(fromBtn) {
  const done = () => {
    document.getElementById("dropCount").textContent = "1";
    if (!reduceMotion) gsap.fromTo(".game-stat-pill.sky", { scale: 1 }, { scale: 1.15, yoyo: true, repeat: 1, duration: 0.15 });
    enterSpendMode();
  };
  if (reduceMotion) { done(); return; }
  const b = pageRect(fromBtn.querySelector(".gg-letter"));
  const target = pageRect(document.getElementById("dropCount"));
  const d = document.createElement("div");
  d.innerHTML = `<svg width="30" height="30" viewBox="0 0 24 24" fill="#38BDF8" aria-hidden="true"><path d="M12 2.5c3.5 4.6 7 8.4 7 12.5a7 7 0 11-14 0c0-4.1 3.5-7.9 7-12.5z"/><path d="M9 12.5a3.5 3.5 0 0 0 1.2 4" stroke="#fff" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>`;
  Object.assign(d.style, { position: "absolute", left: b.left + "px", top: b.top + "px", zIndex: 45, pointerEvents: "none" });
  document.body.appendChild(d);
  gsap.timeline({ onComplete: () => { d.remove(); done(); } })
    .fromTo(d, { scale: 0 }, { scale: 1.2, duration: 0.22, ease: "back.out(2.2)" })
    .to(d, { left: target.left - 6 + "px", top: target.top - 6 + "px", scale: 0.65, duration: 0.6, ease: "power2.inOut" });
}

// ── Spending the drop ───────────────────────────────────────────────────
const plantBtn = document.getElementById("plantBtn");
const waterBtn = document.getElementById("waterBtn");

function packetSVG() {
  return `<svg viewBox="0 0 48 66" aria-hidden="true">
    <rect x="7" y="13" width="38" height="50" rx="5" fill="#E4D2AA"/>
    <rect x="4" y="10" width="38" height="50" rx="5" fill="#FFF8E6"/>
    <path d="M23 10 H42 V55 A5 5 0 0 1 37 60 H23Z" fill="#F1E3C2"/>
    <path d="M4 15 a5 5 0 0 1 5-5 h28 a5 5 0 0 1 5 5 v1.6 l-3.8 3 -3.8-3 -3.8 3 -3.8-3 -3.8 3 -3.8-3 -3.8 3 -3.8-3 -3.8 3 z" fill="#7DB733"/>
    <path d="M23 46 V32" stroke="#5E9A2B" stroke-width="2.4" stroke-linecap="round"/>
    <path d="M23 36 C23 30 19 27 13 27 13 32 17 36 23 36Z" fill="#7DB733"/>
    <path d="M23 39 C23 34 27 31 33 31 33 36 29 39 23 39Z" fill="#A9D04A"/>
    <path d="M11 51.5 h24" stroke="#CBBB93" stroke-width="2" stroke-dasharray="4 3.5" stroke-linecap="round"/>
  </svg>`;
}
function rainCloudSVG() {
  return `<svg viewBox="0 0 64 64" aria-hidden="true">
    <path d="M14 34 A10 10 0 0 1 18 15 A14 14 0 0 1 44 13 A11 11 0 0 1 52 34Z" fill="#9FB3CC"/>
    <path d="M14 34 A10 10 0 0 1 18 15 A14 14 0 0 1 34 9 A16 16 0 0 0 26 30 Z" fill="#C4D3E6"/>
    <rect x="10" y="26" width="46" height="10" rx="5" fill="#9FB3CC"/>
    <g fill="#38BDF8">
      <path class="gg-btn-drop" d="M20 40c2.6 3.4 5.2 6.2 5.2 9.2a5.2 5.2 0 11-10.4 0c0-3 2.6-5.8 5.2-9.2z"/>
      <path class="gg-btn-drop d2" d="M34 43c2.6 3.4 5.2 6.2 5.2 9.2a5.2 5.2 0 11-10.4 0c0-3 2.6-5.8 5.2-9.2z"/>
      <path class="gg-btn-drop d3" d="M48 40c2.6 3.4 5.2 6.2 5.2 9.2a5.2 5.2 0 11-10.4 0c0-3 2.6-5.8 5.2-9.2z"/>
    </g>
  </svg>`;
}
document.getElementById("plantIcon").innerHTML = packetSVG();
document.getElementById("waterIcon").innerHTML = rainCloudSVG();

function firstEmptyPlot() { return garden.stages.findIndex(s => s === 0); }
function plantedCount() { return garden.stages.filter(s => s > 0).length; }

function enterSpendMode() {
  mode = "spend";
  document.getElementById("questionWrap").hidden = true;
  const wrap = document.getElementById("spendWrap");
  wrap.hidden = false;
  // A full garden has nothing to plant into; an empty one has nothing to rain
  // on. They can never both be true, so there's always at least one choice.
  plantBtn.disabled = firstEmptyPlot() === -1;
  waterBtn.disabled = plantedCount() === 0;
  document.getElementById("fullNote").hidden = !plantBtn.disabled;
  const next = firstEmptyPlot();
  if (next !== -1) plotEls[next].classList.add("targeted");
  if (!reduceMotion) gsap.from(wrap.children, { y: 14, opacity: 0, stagger: 0.07, duration: 0.35, ease: "back.out(1.5)", clearProps: "transform,translate,opacity" });
}

function leaveSpendMode() {
  mode = "busy";
  document.getElementById("spendWrap").hidden = true;
  document.getElementById("dropCount").textContent = "0";
  plotEls.forEach(p => p.classList.remove("targeted"));
}

plantBtn.addEventListener("click", () => {
  if (mode !== "spend") return;
  const i = firstEmptyPlot();
  if (i === -1) return;
  // Measure the button before leaveSpendMode() hides it (a hidden element measures 0×0).
  const from = pageRect(plantBtn.querySelector(".gg-spend-icon svg"));
  leaveSpendMode();
  GameKit.track('garden_spend', { action: 'plant', plot: i });
  sowSeed(i, from, () => {
    garden.stages[i] = 1;
    renderPlot(i, true); // assigns the flower colour — save after
    saveGarden();
    updateSceneStatus();
    gsap.delayedCall(reduceMotion ? 0.3 : 1.4, nextQuestion);
  });
});

waterBtn.addEventListener("click", () => {
  if (mode !== "spend" || plantedCount() === 0) return;
  leaveSpendMode();
  rainStorm();
});

// The packet flies to the plot, tips, and a seed drops into the soil.
function sowSeed(i, from, done) {
  if (reduceMotion) { done(); return; }
  const S = SPOTS[i];
  const land = scenePoint(S.x, S.y);
  const packet = document.createElement("div");
  packet.className = "gg-flying-packet";
  packet.innerHTML = packetSVG();
  Object.assign(packet.style, { position: "absolute", left: from.left + "px", top: from.top + "px", width: from.width + "px", height: from.height + "px", zIndex: 45, pointerEvents: "none" });
  document.body.appendChild(packet);
  gsap.timeline({ onComplete: () => { packet.remove(); done(); } })
    .to(packet, { left: (land.x - from.width / 2) + "px", top: (land.y - from.height - 46) + "px", scale: 0.8, duration: 0.55, ease: "power2.inOut" })
    .to(packet, { rotation: 140, transformOrigin: "50% 80%", duration: 0.28, ease: "power1.inOut" })
    .add(() => seedDrop(land.x, land.y - 40, land.y))
    .to(packet, { rotation: 0, duration: 0.22, ease: "power2.inOut" }, "+=0.32")
    .to(packet, { opacity: 0, y: -14, duration: 0.2 });
}
function seedDrop(x, y, landY) {
  const s = document.createElement("span");
  Object.assign(s.style, { position: "absolute", left: (x - 4) + "px", top: y + "px", width: "8px", height: "10px", borderRadius: "50% 50% 60% 60%", background: "#7C4A0E", zIndex: 43, pointerEvents: "none" });
  document.body.appendChild(s);
  gsap.to(s, { top: landY + "px", rotation: 180, duration: 0.3, ease: "power2.in", onComplete: () => { s.remove(); soilPuff(x, landY); } });
}
function soilPuff(cx, y) {
  for (let k = 0; k < 7; k++) {
    const p = document.createElement("span");
    Object.assign(p.style, { position: "absolute", left: (cx - 3) + "px", top: y + "px", width: "6px", height: "6px", borderRadius: "50%", background: k % 2 ? "#854D0E" : "#A16207", zIndex: 43, pointerEvents: "none" });
    document.body.appendChild(p);
    gsap.to(p, { x: (Math.random() - 0.5) * 54, y: -14 - Math.random() * 18, opacity: 0, duration: 0.5, ease: "power2.out", onComplete: () => p.remove() });
  }
}

// Rain falls on the WHOLE garden: every planted plot climbs one stage at once.
// Plots that were ALREADY fully grown before the storm can't climb further, so
// each drops a grain instead — at most N_PLOTS grains per storm, which is what
// the server-side cap in POST /api/garden-grow/<id>/completion allows.
const scene = document.getElementById("gardenScene");
function rainStorm() {
  const growing = [], ripe = [];
  for (let i = 0; i < N_PLOTS; i++) {
    if (garden.stages[i] === 3) ripe.push(i);
    else if (garden.stages[i] > 0) growing.push(i);
  }
  const finish = () => {
    if (growing.length) saveGarden();
    updateSceneStatus();
    GameKit.track('garden_spend', { action: 'water', grown: growing.length, grains: ripe.length });
    harvestGrains(ripe, () => gsap.delayedCall(0.4, nextQuestion));
  };
  if (reduceMotion) {
    growing.forEach(i => { garden.stages[i]++; renderPlot(i, false); });
    finish();
    return;
  }
  scene.classList.add("storm");
  const rain = setInterval(() => { spawnRainDrop(); spawnRainDrop(); spawnRainDrop(); }, 50);
  growing.forEach((i, k) => gsap.delayedCall(0.9 + k * 0.22, () => {
    garden.stages[i]++;
    renderPlot(i, true);
  }));
  const endAt = Math.max(2.2, 0.9 + growing.length * 0.22 + 0.8);
  gsap.delayedCall(endAt, () => {
    clearInterval(rain);
    scene.classList.remove("storm");
    gsap.delayedCall(0.6, finish);
  });
}
// Raindrops live inside the scene so its overflow clips them to the clearing.
function spawnRainDrop() {
  const d = document.createElement("span");
  d.className = "gg-raindrop";
  d.style.left = (Math.random() * 104 - 2) + "%";
  scene.appendChild(d);
  gsap.to(d, { y: scene.clientHeight + 20, x: -12, duration: 0.55 + Math.random() * 0.25, ease: "power1.in", onComplete: () => d.remove() });
}

// Each fully grown plant drops a golden grain that flies to the counter. The
// count ticks when it LANDS, so the number never runs ahead of what was seen.
function harvestGrains(indices, done) {
  if (!indices.length) { done(); return; }
  let landed = 0;
  indices.forEach((i, k) => gsap.delayedCall(k * 0.2, () => harvestGrain(i, () => { if (++landed === indices.length) done(); })));
}
function harvestGrain(i, done) {
  const S = SPOTS[i];
  const from = scenePoint(S.x, S.y - 90 * S.s);
  const target = pageRect(document.getElementById("grainCount"));
  const tick = () => {
    grains++;
    document.getElementById("grainCount").textContent = grains;
    if (!reduceMotion) gsap.fromTo("#grainPill", { scale: 1 }, { scale: 1.15, yoyo: true, repeat: 1, duration: 0.15 });
    done();
  };
  if (reduceMotion) { tick(); return; }
  const g = document.createElement("div");
  g.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3C16.5 7 18 11 18 14.5A6 6 0 0 1 6 14.5C6 11 7.5 7 12 3Z" fill="#F5B82E"/><path d="M12 3C16.5 7 18 11 18 14.5A6 6 0 0 1 12 20.5C14.5 17 15 10 12 3Z" fill="#D9921A"/></svg>`;
  Object.assign(g.style, { position: "absolute", left: (from.x - 12) + "px", top: (from.y - 12) + "px", zIndex: 45, pointerEvents: "none" });
  document.body.appendChild(g);
  sparkle(from.x, from.y, "#FCD34D");
  gsap.timeline({ onComplete: () => { g.remove(); tick(); } })
    .fromTo(g, { scale: 0 }, { scale: 1.3, duration: 0.28, ease: "back.out(2)" })
    .to(g, { left: target.left + "px", top: target.top + "px", scale: 0.7, duration: 0.65, ease: "power2.inOut" }, "+=0.1");
}

function sparkle(x, y, color) {
  for (let k = 0; k < 10; k++) {
    const s = document.createElement("span");
    Object.assign(s.style, { position: "absolute", left: (x - 4) + "px", top: (y - 4) + "px", width: "8px", height: "8px", borderRadius: "2px", background: color, zIndex: 43, pointerEvents: "none", transform: "rotate(45deg)" });
    document.body.appendChild(s);
    gsap.to(s, { x: (Math.random() - 0.5) * 100, y: (Math.random() - 0.7) * 84, rotation: 225, opacity: 0, duration: 0.8, ease: "power2.out", onComplete: () => s.remove() });
  }
}

function nextQuestion() {
  qi++;
  if (qi >= questions.length) { finishGame(); return; }
  renderQuestion();
  GameKit.speakQuestion(questions[qi]);
}

function showHint(text) {
  const hint = document.getElementById("tryAgain");
  if (!hint.dataset.text) hint.dataset.text = hint.textContent;
  hint.textContent = text || hint.dataset.text;
  gsap.killTweensOf(hint);
  gsap.fromTo(hint, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.25, onComplete: () => gsap.to(hint, { opacity: 0, delay: 1.1 }) });
}

// ── Finish ──────────────────────────────────────────────────────────────
async function finishGame() {
  mode = "done";
  document.getElementById("questionWrap").hidden = true;
  document.getElementById("spendWrap").hidden = true;
  updateProgress();
  if (!reduceMotion) for (let i = 0; i < 3; i++) spawnButterfly(i);

  await GameKit.finish({ grains }, { after: reduceMotion ? 600 : 2200 });
}

function spawnButterfly(i) {
  const wrap = document.createElement("div");
  const a = ["#F472B6", "#38BDF8", "#FCD34D"][i], b = ["#FB7185", "#7DD3FC", "#FDE68A"][i];
  wrap.innerHTML = `<svg width="34" height="28" viewBox="0 0 34 28" aria-hidden="true">
    <g class="gg-wing-l"><path d="M16 12 C8 0 0 2 2 10 C3 16 10 16 16 13Z" fill="${a}"/><path d="M16 14 C9 16 4 22 8 25 C12 27 15 21 16 15Z" fill="${b}"/></g>
    <g class="gg-wing-r"><path d="M18 12 C26 0 34 2 32 10 C31 16 24 16 18 13Z" fill="${a}"/><path d="M18 14 C25 16 30 22 26 25 C22 27 19 21 18 15Z" fill="${b}"/></g>
    <rect x="15.5" y="6" width="3" height="16" rx="1.5" fill="#1E1B4B"/></svg>`;
  Object.assign(wrap.style, { position: "absolute", zIndex: 5, left: "-40px", top: (40 + i * 46) + "px", pointerEvents: "none" });
  scene.appendChild(wrap);
  gsap.to(wrap.querySelector(".gg-wing-l"), { scaleX: 0.4, transformOrigin: "right center", yoyo: true, repeat: -1, duration: 0.15 });
  gsap.to(wrap.querySelector(".gg-wing-r"), { scaleX: 0.4, transformOrigin: "left center", yoyo: true, repeat: -1, duration: 0.15 });
  const w = scene.offsetWidth;
  gsap.to(wrap, { duration: 5 + i, delay: i * 0.4, ease: "none",
    keyframes: [{ x: w * 0.3, y: -25 }, { x: w * 0.55, y: 15 }, { x: w * 0.8, y: -20 }, { x: w + 60, y: 5 }] });
}

// ── Start ───────────────────────────────────────────────────────────────
buildGarden();
updateSceneStatus();
loadQuestions();
</script>
</GamePage>
