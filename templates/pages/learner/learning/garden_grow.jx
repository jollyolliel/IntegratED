{#- Garden Grow: a jungle clearing that is the learner's own. Each right answer earns a water drop,
    which the learner spends on planting a seed or making it rain over the whole clearing; rain grows
    every plant a stage, and a fully grown plant drops a golden grain (bonus XP). The 8-plot garden
    is saved on the learner and carries over between lessons. No timer, no penalty for a wrong
    answer. The backdrop (.gg-world: rainforest morning, golden hour or moonlit fireflies, by lesson
    id) is decoration only — no ids, no JS hooks; the plants layer
    between its back and front SVGs is what the script draws. -#}
{#import "@components/shell/game_page.jx" as GamePage #}
{#import "@components/audio_button.jx" as AudioButton #}
{#import "@components/base/button.jx" as Button #}
{#import "@components/base/card.jx" as Card #}
{#def lesson, garden_plots, already_completed=False #}
<GamePage title={{ t('learner.garden_grow.title') ~ ' — ' ~ lesson.title ~ ' - IntegratED' }} lesson={{ lesson }} styles="game-garden-grow">
  <main class="gg-layout" id="page-content">

    <!-- ═══ The question side ═══ -->
    <section class="gg-play">
      <div class="flex items-center gap-2">
        <span class="w-8 h-8 rounded-xl flex items-center justify-center bg-green-100 border-2 border-green-300 text-accent" aria-hidden="true">
          <svg class="w-5 h-5" viewBox="0 0 24 24"><path d="M12 21V11" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path d="M12 12C12 7 8.5 4 3.5 4 3.5 9 7 12 12 12Z" fill="currentColor"/><path d="M12 14C12 10 15 7.5 20.5 7.5 20.5 12 17 14 12 14Z" fill="currentColor" opacity=".7"/></svg>
        </span>
        <h1 class="display-font font-bold text-sm text-sky-700 uppercase tracking-widest">{{ t('learner.garden_grow.title') }}</h1>
      </div>

      {% if already_completed %}
      <div class="rounded-2xl px-4 py-2.5 text-sm font-semibold bg-amber-100 border-2 border-amber-300 text-amber-800">
        {{ t('learner.garden_grow.already_completed') }} {{ t('learner.garden_grow.replay_no_xp') }}
      </div>
      {% endif %}

      <div id="errorState" class="hidden py-10 text-center rounded-2xl p-6 bg-red-50 border-2 border-red-200">
        <p class="text-danger font-bold mb-4">{{ t('learner.garden_grow.load_failed') }}</p>
        <Button variant="danger" onclick="location.reload()">{{ t('learner.garden_grow.reload') }}</Button>
      </div>

      <!-- Answering earns the drop -->
      <div id="questionWrap" class="flex flex-col gap-3.5" hidden>
        <div class="gg-question">
          <AudioButton id="speakerBtn" label={{ t('learner.garden_grow.read_aloud') }} />
          <div class="min-w-0">
            <p class="gg-step">{{ t('learner.garden_grow.earn_prompt') }}</p>
            <p id="questionText" class="gg-qtext"></p>
          </div>
        </div>
        <p class="text-xs font-bold uppercase tracking-wider text-ink-muted text-center">{{ t('learner.garden_grow.tap_answer') }}</p>
        <div id="answerList" class="gg-answers"></div>
      </div>

      <!-- Spending the drop: plant a seed or make it rain -->
      <div id="spendWrap" class="flex flex-col gap-3.5" hidden>
        <div class="gg-choice-banner">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5c3.5 4.6 7 8.4 7 12.5a7 7 0 11-14 0c0-4.1 3.5-7.9 7-12.5z"/></svg>
          <div>
            <p class="display-font font-bold text-base text-sky-950">{{ t('learner.garden_grow.choice_title') }}</p>
            <p class="text-xs font-semibold text-ink-muted">{{ t('learner.garden_grow.choice_hint') }}</p>
          </div>
        </div>
        <div class="gg-spend-row">
          <Card tone="green" clickable id="plantBtn" class="gg-spend">
            <span class="gg-spend-icon" id="plantIcon" aria-hidden="true"></span>
            <span class="gg-action-label">{{ t('learner.garden_grow.action_plant') }}</span>
            <span class="gg-action-hint">{{ t('learner.garden_grow.action_plant_hint') }}</span>
          </Card>
          <Card clickable id="waterBtn" class="gg-spend">
            <span class="gg-spend-icon" id="waterIcon" aria-hidden="true"></span>
            <span class="gg-action-label">{{ t('learner.garden_grow.action_water') }}</span>
            <span class="gg-action-hint">{{ t('learner.garden_grow.action_water_hint') }}</span>
          </Card>
        </div>
        <p class="gg-full-note" id="fullNote" hidden>{{ t('learner.garden_grow.full_note') }}</p>
      </div>
    </section>

    <!-- ═══ The clearing ═══ -->
    <section class="gg-stage">
      <div class="gg-hud">
        <div class="gg-hud-row">
          <span id="progressLabel" class="gg-hud-label">—</span>
          <div class="progress-track flex-1"><div id="progressFill" class="progress-fill" style="width:0%"></div></div>
        </div>
        <div class="gg-hud-row">
          <span class="game-stat-pill sky" title="{{ t('learner.garden_grow.drops_label') }}">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5c3.5 4.6 7 8.4 7 12.5a7 7 0 11-14 0c0-4.1 3.5-7.9 7-12.5z"/></svg>
            <span id="dropCount">0</span>
            <span class="sr-only">{{ t('learner.garden_grow.drops_label') }}</span>
          </span>
          <span class="game-stat-pill" id="grainPill" title="{{ t('learner.garden_grow.grains_label') }}">
            <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3C16.5 7 18 11 18 14.5A6 6 0 0 1 6 14.5C6 11 7.5 7 12 3Z" fill="#F5B82E"/><path d="M12 3C16.5 7 18 11 18 14.5A6 6 0 0 1 12 20.5C14.5 17 15 10 12 3Z" fill="#D9921A"/></svg>
            <span id="grainCount">0</span>
            <span class="sr-only">{{ t('learner.garden_grow.grains_label') }}</span>
          </span>
          <span class="gg-streak" id="streakNote"></span>
        </div>
      </div>

      <div class="gg-scene" id="gardenScene">
      <div class="gg-world" aria-hidden="true">
        {#- One of three scenes, picked by lesson id so a lesson always shows the same one:
            rainforest morning, golden hour, moonlit fireflies. -#}
        {% set scene = lesson.id % 3 %}
        {% if scene == 0 %}
        <svg class="gg-back" viewBox="0 0 600 600" preserveAspectRatio="xMidYMax slice" aria-hidden="true"><defs><linearGradient id="ggm-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#AEDDF2"/><stop offset="0.5" stop-color="#D2EEF7"/><stop offset="1" stop-color="#EAF7F1"/></linearGradient><radialGradient id="ggm-glow"><stop offset="0" stop-color="#FFFBE6" stop-opacity="0.95"/><stop offset="0.35" stop-color="#FFFBE6" stop-opacity="0.45"/><stop offset="1" stop-color="#FFFBE6" stop-opacity="0"/></radialGradient><linearGradient id="ggm-mist" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F2FAF7" stop-opacity="0"/><stop offset="0.55" stop-color="#F2FAF7" stop-opacity="0.85"/><stop offset="1" stop-color="#F2FAF7" stop-opacity="0"/></linearGradient></defs><rect width="600" height="600" fill="url(#ggm-sky)"/><circle cx="468" cy="118" r="120" fill="url(#ggm-glow)"/><circle cx="468" cy="118" r="30" fill="#FFF6D8"/><path class="gg-drift" d="M40 150a20 20 0 0 1 26 -16a28 28 0 0 1 50 -6a18 18 0 0 1 28 14a12 12 0 0 1 10 8Z" fill="#F6FCFB" style="opacity:0.95;--gg-drift-d:60s"/><path class="gg-drift" d="M400 196a16 16 0 0 1 20.8 -12.8a22.4 22.4 0 0 1 40 -4.8a14.4 14.4 0 0 1 22.4 11.2a9.6 9.6 0 0 1 8 6.4Z" fill="#F6FCFB" style="opacity:0.85;--gg-drift-d:75s"/><path class="gg-drift" d="M250 110a12 12 0 0 1 15.6 -9.6a16.8 16.8 0 0 1 30 -3.6a10.8 10.8 0 0 1 16.8 8.4a7.2 7.2 0 0 1 6 4.8Z" fill="#F6FCFB" style="opacity:0.7;--gg-drift-d:90s"/><path d="M-10 300C1.7 297 35 290.3 60 282C85 273.7 115 251 140 250C165 249 186.7 277.7 210 276C233.3 274.3 256.7 248 280 240C303.3 232 326.7 224.3 350 228C373.3 231.7 396.7 260.7 420 262C443.3 263.3 466.7 243.3 490 236C513.3 228.7 540 218.7 560 218C580 217.3 601.7 229.7 610 232L610 610L-10 610Z" fill="#BCD8D4"/><path d="M-10 326C3.3 323.7 46.7 317 70 312C93.3 307 108.3 295 130 296C151.7 297 176.7 317.3 200 318C223.3 318.7 248.3 300.7 270 300C291.7 299.3 308.3 315.7 330 314C351.7 312.3 376.7 291 400 290C423.3 289 446.7 308.