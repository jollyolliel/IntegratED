                <stop offset=".46" stop-color="#4C3A93"/>
                <stop offset=".58" stop-color="#8A5AA8"/>
                <stop offset=".66" stop-color="#E39AAE"/>
                <stop offset=".72" stop-color="#F8C9A6"/>
