{#- Lantern Sky (game_type word_storm): the answers are lanterns meandering over a night scene. The
    right one rises into the sky and becomes a star; the stars join into a constellation that
    turns into a bird when the lesson is done. No timer, no hearts: a wrong lantern dims and
    drifts back, and the learner tries again. Score counts first-try answers only. -#}
{#import "@components/shell/game_page.jx" as GamePage #}
{#import "@components/audio_button.jx" as AudioButton #}
{#import "@components/base/button.jx" as Button #}
{#def lesson, already_completed=False #}
{%- set head %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"/>
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js" onload="renderMathInElement(document.getElementById('questionText'),{delimiters:[{left:'$',right:'$',display:false}]})"></script>
{%- endset %}
<GamePage title={{ t('learner.word_storm.title') ~ ' — ' ~ lesson.title ~ ' - IntegratED' }} lesson={{ lesson }} head={{ head }}
  styles="game-word-storm">
    <main class="ws-wrap" id="page-content">
      <section class="ws-panel">
        <div class="ws-head">
          <div class="ws-title">
            <span class="ws-title-icon" aria-hidden="true">
              <svg width="20" height="24" viewBox="0 0 120 150"><use href="{{ url_for('static', filename='svg/games/word_storm/lanterns.svg') }}#lantern-a" class="ws-lantern-tone-a"/></svg>
            </span>
            <h1 class="display-font font-bold text-sm text-sky-700 uppercase tracking-widest">{{ t('learner.word_storm.title') }}</h1>
          </div>
          <div class="ws-progress">
            <span id="progressLabel" class="text-xs font-bold text-ink-muted whitespace-nowrap font-mono">—</span>
            <div class="progress-track flex-1"><div id="progressFill" class="progress-fill" style="width:0%"></div></div>
            <span id="streakNote" class="ws-streak" hidden></span>
          </div>
        </div>

        {% if already_completed %}
        <div class="rounded-2xl px-4 py-2.5 text-sm font-semibold bg-amber-100 border-2 border-amber-300 text-amber-800">
          {{ t('learner.word_storm.already_completed') }} {{ t('learner.word_storm.replay_no_xp') }}
        </div>
        {% endif %}

        <div id="errorState" class="hidden py-8 text-center rounded-2xl p-6 bg-red-50 border-2 border-red-200">
          <p class="text-danger font-bold mb-4">{{ t('learner.word_storm.load_failed') }}</p>
          <Button variant="danger" onclick="location.reload()">{{ t('learner.word_storm.reload') }}</Button>
        </div>

        <div class="ws-question" id="questionCard">
          <AudioButton id="speakerBtn" label={{ t('learner.word_storm.read_aloud') }} />
          <div class="min-w-0">
            <p id="questionPrompt" class="text-[11px] font-bold uppercase tracking-wider text-primary mb-0.5"></p>
            <p id="questionText" class="ws-question-text display-font font-bold"></p>
          </div>
        </div>
        <p class="ws-instruction">
          <svg width="18" height="22" viewBox="0 0 120 150" aria-hidden="true"><use href="{{ url_for('static', filename='svg/games/word_storm/lanterns.svg') }}#lantern-d" class="ws-lantern-tone-d"/></svg>
          {{ t('learner.word_storm.tap_lantern') }}
        </p>
      </section>

      <div class="ws-frame">
        <section class="ws-stage" id="wsStage" aria-label="{{ t('learner.word_storm.tap_lantern') }}">
          <div class="ws-backdrop ws-lake" data-ws-motion="swirl" style="--ws-float:0.9;--ws-gust:1.1" aria-hidden="true">
          <svg class="ws-lake-world" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
            <defs>
              <linearGradient id="wsLakeSky9" x1="0" y1="0" x2="0" y2="1">
