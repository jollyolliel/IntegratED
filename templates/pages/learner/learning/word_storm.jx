          <g class="ws-lake-fly ws-lake-fly-b" style="animation-delay:-3.4s"><circle cx="250" cy="180" r="8" fill="#FDE68A" opacity=".22"/><circle cx="250" cy="180" r="2.6" fill="#FEF9C3"/></g>
          </svg>
          </div>
          <svg class="ws-sky" id="skyChart" viewBox="0 0 200 80" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
            <path class="ws-sky-figure" id="skyFigure" d="M12 62 Q30 66 48 66 Q70 72 92 74 Q116 75 134 70 Q152 65 164 58 L188 50 L170 43 Q160 42 150 46 Q166 26 178 10 Q150 22 128 42 Q112 22 96 6 Q92 30 84 46 Q62 46 40 52 Q26 56 12 62 Z"/>
            <g id="skyLines"></g>
            <g id="skyStars"></g>
          </svg>
          <canvas id="burstCanvas"></canvas>
          <div class="ws-lanterns" id="lanternLayer" role="group" aria-label="{{ t('learner.word_storm.tap_lantern') }}"></div>
          <p class="sr-only" id="skyStatus" aria-live="polite"></p>
        </section>
      </div>
    </main>

    <div class="game-hint-toast" id="tryAgain" role="status">{{ t('learner.word_storm.try_another') }}</div>

<script>
// ============================================================
// Lantern Sky (word_storm). One question at a time; its options float as
// four lanterns that meander inside the stage — never off it, so drifting
// is not a hidden timer. A right lantern flies up and becomes the next star
// of the constellation; a wrong one dims and drifts away, then wanders back.
// ============================================================
const lessonId = {{ lesson.id }};
GameKit.init({ lessonId, game: 'word_storm' });
const LANTERN_SPRITE = {{ url_for('static', filename='svg/games/word_storm/lanterns.svg') | tojson }};
const T = {
  questionOf: {{ t('learner.word_storm.question_of') | tojson }},
  allDone:    {{ t('learner.word_storm.all_done') | tojson }},
  streak:     {{ t('learner.word_storm.streak') | tojson }},
  skyStatus:  {{ t('learner.word_storm.sky_status') | tojson }},
  checkFailed: {{ t('learner.game.check_failed') | tojson }},
};
const LETTERS = ['A', 'B', 'C', 'D'];
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

const stage = document.getElementById('wsStage');
const layer = document.getElementById('lanternLayer');
const sky = document.getElementById('skyChart');

let questions = [];
let qi = 0;
let firstTry = true;
let streak = 0;    // first-try corrects in a row, for the "2 in a row!" note
let mode = 'loading'; // loading | question | busy | done
let lanterns = [];

document.getElementById('speakerBtn').addEventListener('click', () => GameKit.speakQuestion(questions[qi]));

// ── Burst canvas (light particles + a soft ring where a star lands) ─────
const canvas = document.getElementById('burstCanvas');
const ctx = canvas.getContext('2d');
let particles = [], rings = [], burstRaf = 0;
function sizeCanvas() {
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  canvas.width = stage.clientWidth * dpr; canvas.height = stage.clientHeight * dpr;
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
}
function spawnBurst(x, y, rgb, n) {
  if (reduceMotion) n = Math.min(n, 8);
  rings.push({ x, y, r: 6, maxR: 70, life: 1, rgb });
  for (let i = 0; i < n; i++) {
    const a = (Math.PI * 2 / n) * i + Math.random() * 0.5;
    const s = 1.6 + Math.random() * 3.6;
    particles.push({ x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s - 0.6, r: 2 + Math.random() * 3.2,
      life: 0.9 + Math.random() * 0.3, decay: 0.014 + Math.random() * 0.01, rgb });
  }
  if (!burstRaf) burstRaf = requestAnimationFrame(drawBurst);
}
function drawBurst() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  rings.forEach(s => {
    s.r += (s.maxR - s.r) * 0.12; s.life -= 0.04;
    if (s.life > 0) {
      ctx.beginPath(); ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(${s.rgb},${(s.life * 0.7).toFixed(2)})`; ctx.lineWidth = 3.5 * s.life; ctx.stroke();
    }
  });
  rings = rings.filter(s => s.life > 0);
  particles.forEach(p => {
    p.x += p.vx; p.y += p.vy; p.vx *= 0.95; p.vy = p.vy * 0.95 + 0.04;
    p.life -= p.decay; p.r *= 0.98;
    if (p.life > 0) {
      ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${p.rgb},${p.life.toFixed(2)})`; ctx.fill();
    }
  });
  particles = particles.filter(p => p.life > 0);
  burstRaf = (particles.length || rings.length) ? requestAnimationFrame(drawBurst) : 0;
}

// ── Constellation: a bird, one star per question ────────────────────────
// Outline of a bird gliding with both wings up, in the sky SVG's 200×80
// units, in drawing order. PRIORITY says which points carry the shape best,
// so a 3-question lesson still gets beak + both wingtips.
const BIRD = [[12,62],[48,66],[92,74],[134,70],[164,58],[188,50],[170,43],[150,46],[178,10],[128,42],[96,6],[84,46],[40,52]];
const PRIORITY = [5, 8, 10, 0, 2, 12, 4, 3, 6, 9, 11, 1, 7];
function constellationPoints(n) {
  if (n <= BIRD.length) return PRIORITY.slice(0, n).sort((a, b) => a - b).map(i => BIRD[i]);
  const pts = BIRD.map(p => p.slice());
  while (pts.length < n) {          // longer lessons: split the longest edge
    let best = 0, bestLen = -1;
    pts.forEach((p, i) => { const q = pts[(i + 1) % pts.length]; const d = Math.hypot(q[0] - p[0], q[1] - p[1]); if (d > bestLen) { bestLen = d; best = i; } });
    const p = pts[best], q = pts[(best + 1) % pts.length];
    pts.splice(best + 1, 0, [(p[0] + q[0]) / 2, (p[1] + q[1]) / 2]);
  }
  return pts;
}
const SVG_NS = 'http://www.w3.org/2000/svg';
let starPts = [], lit = 0;
function svgEl(tag, attrs) { const el = document.createElementNS(SVG_NS, tag); for (const k in attrs) el.setAttribute(k, attrs[k]); return el; }
function starPath(r) { return `M0 ${-r} Q${r*0.18} ${-r*0.18} ${r} 0 Q${r*0.18} ${r*0.18} 0 ${r} Q${-r*0.18} ${r*0.18} ${-r} 0 Q${-r*0.18} ${-r*0.18} 0 ${-r} Z`; }
function buildSky(n) {
  starPts = constellationPoints(n);
  lit = 0;
  const lines = document.getElementById('skyLines'), stars = document.getElementById('skyStars');
  lines.innerHTML = ''; stars.innerHTML = '';
  starPts.forEach(([x, y]) => stars.appendChild(svgEl('circle', { class: 'ws-sky-slot', cx: x, cy: y, r: 1.3 })));
  gsap.set('#skyFigure', { opacity: 0 });
  updateSkyStatus();
}
function updateSkyStatus() {
  document.getElementById('skyStatus').textContent = T.skyStatus.replace('{lit}', lit).replace('{total}', starPts.length);
}
// Where a constellation point sits on the stage, in stage pixels.
function skyPointOnStage([x, y]) {
  const m = sky.getScreenCTM(), s = stage.getBoundingClientRect();
  const pt = sky.createSVGPoint(); pt.x = x; pt.y = y;
  const p = pt.matrixTransform(m);
  return { x: p.x - s.left, y: p.y - s.top };
}
function drawLine(a, b, cls) {
  const line = svgEl('line', { class: 'ws-sky-line' + (cls ? ' ' + cls : ''), x1: a[0], y1: a[1], x2: b[0], y2: b[1] });
  document.getElementById('skyLines').appendChild(line);
  if (reduceMotion) return;
  const len = Math.hypot(b[0] - a[0], b[1] - a[1]);
  line.style.strokeDasharray = cls ? '' : len; // the closing line stays dotted
  if (!cls) gsap.fromTo(line, { strokeDashoffset: len }, { strokeDashoffset: 0, duration: 0.55, ease: 'power2.out' });
  else gsap.from(line, { opacity: 0, duration: 0.6 });
}
function lightStar(gold) {
  const [x, y] = starPts[lit];
  const g = svgEl('g', { transform: `translate(${x} ${y})` });
  g.appendChild(svgEl('circle', { class: 'ws-sky-glow', r: 5.5 }));
  g.appendChild(svgEl('path', { class: 'ws-sky-star' + (gold ? ' is-gold' : ''), d: starPath(gold ? 3.6 : 2.9) }));
  document.getElementById('skyStars').appendChild(g);
  if (!reduceMotion) gsap.from(g.children, { scale: 0, transformOrigin: '50% 50%', duration: 0.6, ease: 'back.out(2.5)', stagger: 0.05 });
  if (lit > 0) drawLine(starPts[lit - 1], starPts[lit]);
  lit++;
  updateSkyStatus();
}

// ── Lanterns ────────────────────────────────────────────────────────────
function lanternWidth() {
  const w = stage.clientWidth, h = stage.clientHeight;
  return Math.round(Math.max(96, Math.min(148, w * 0.25, h * 0.2)));
}
function wordSize(word, lw) {
  // An answer that is only emoji/symbols (no letters or digits) is drawn much bigger.
  if (!/[\p{L}\p{N}]/u.test(String(word))) return Math.round(lw * 0.3 / Math.max(1, [...new Intl.Segmenter().segment(String(word).trim())].length * 0.6)) + 'px';
  const base = lw * 0.17, len = String(word).length;
  return Math.max(12, Math.min(base, base * 7 / Math.max(7, len))) + 'px';
}
// Where the lanterns wander: anywhere on the stage, kept fully inside it.
function zone(b) {
  const W = stage.clientWidth, H = stage.clientHeight;
  const minX = b.w / 2 + 4, minY = b.h / 2 + 4;
  return { minX, maxX: Math.max(minX, W - b.w / 2 - 4), minY, maxY: Math.max(minY, H - b.h / 2 - 4) };
}
function makeLantern(word, i) {
  const el = document.createElement('button');
  el.type = 'button';
  el.className = 'ws-lantern ws-lantern-tone-' + 'abcd'[i];
  el.setAttribute('aria-label', LETTERS[i] + ': ' + word);
  el.innerHTML = `<span class="ws-lantern-bob"><span class="ws-lantern-glow"></span>
    <svg class="ws-lantern-art" viewBox="0 0 120 150" aria-hidden="true"><use href="${LANTERN_SPRITE}#lantern-${'abcd'[i]}"/></svg>
    <span class="ws-lantern-word"></span><span class="ws-lantern-letter" aria-hidden="true">${LETTERS[i]}</span></span>`;
  el.querySelector('.ws-lantern-word').textContent = word;
  layer.appendChild(el);
  const b = { el, word, bob: el.firstElementChild, x: 0, y: 0, w: 0, h: 0, heading: Math.random() * Math.PI * 2,
    speed: 14 + Math.random() * 10, v: 0, held: false, kick: null, phase: Math.random() * 6.28, flying: false,
    drag: 0.8 + Math.random() * 0.4, blend: 1 };
  sizeLantern(b);
  const hold = on => () => { b.held = on; };
  el.addEventListener('pointerenter', hold(true)); el.addEventListener('pointerleave', hold(false));
  el.addEventListener('focus', hold(true)); el.addEventListener('blur', hold(false));
  el.addEventListener('click', () => onLantern(b));
  return b;
}
function sizeLantern(b) {
  const lw = lanternWidth();
  b.w = lw; b.h = lw * 1.25 + 26;
  b.el.style.setProperty('--lw', lw + 'px');
  b.el.style.setProperty('--fs', wordSize(b.word, lw));
  // A word never breaks across lines: if it still overflows the lantern, shrink it to fit.
  const tag = b.el.querySelector('.ws-lantern-word');
  const room = lw * 0.86;
  if (tag.offsetWidth > room) {
    b.el.style.setProperty('--fs', Math.max(11, parseFloat(getComputedStyle(tag).fontSize) * room / tag.offsetWidth) + 'px');
  }
}
// Moved with the `translate` property at sub-pixel precision: composited, no layout per frame,
// and slow drifts glide instead of stepping a whole pixel at a time.
function placeLantern(b) {
  b.el.style.translate = `${(b.x - b.w / 2).toFixed(2)}px ${(b.y - b.h / 2).toFixed(2)}px`;
}

// ── Scene motion ────────────────────────────────────────────────────────
// The backdrop names how the wind brings lanterns in and takes them away (data-ws-motion) and
// sets --ws-float (drift speed) and --ws-gust (wind strength). Read from the backdrop that is
// showing, so a swapped scene takes effect without a reload.
let motion = { kind: '', float: 1, gust: 1 };
function readMotion() {
  const el = [...stage.querySelectorAll('.ws-backdrop')].find(e => e.getClientRects().length);
  if (!el) return;
  const cs = getComputedStyle(el);
  motion = {
    kind: el.dataset.wsMotion || '',
    float: parseFloat(cs.getPropertyValue('--ws-float')) || 1,
    gust: parseFloat(cs.getPropertyValue('--ws-gust')) || 1,
  };
}
// A gust on top of the breeze: more streaks, more lean, while lanterns blow in or out.
const gustBoost = { v: 0 };
function gust(peak, dur) {
  gsap.killTweensOf(gustBoost);
  gsap.timeline()
    .to(gustBoost, { v: peak * motion.gust, duration: dur * 0.3, ease: 'sine.out' })
    .to(gustBoost, { v: 0, duration: dur * 0.7, ease: 'sine.inOut' });
}
// Tween a 0→1 progress and place the lantern on path(t) each frame.
function along(b, path, vars) {
  const p = { t: 0 };
  return gsap.to(p, Object.assign({ t: 1, onUpdate: () => { const [x, y] = path(p.t); b.x = x; b.y = y; placeLantern(b); } }, vars));
}

// Blowing in: each lantern starts off the left edge and settles at `to`.
const ENTER = {
  // Long glide: one long gust carries each lantern up in an arc; it leans into the wind and settles.
  glide(b, i, to) {
    const from = { x: -b.w * (0.7 + i * 0.35), y: to.y + 50 + Math.random() * 50 }, lift = 50 + Math.random() * 40;
    gsap.set(b.bob, { rotation: 16 });
    return gsap.timeline({ delay: i * 0.18 })
      .add(along(b, t => [from.x + (to.x - from.x) * t, from.y + (to.y - from.y) * t - Math.sin(Math.PI * t) * lift],
        { duration: 2.1 + i * 0.15, ease: 'power3.out' }))
      .to(b.bob, { rotation: 0, duration: 1.6, ease: 'back.out(2.2)' }, 0.7);
  },
  // Sharp gust: the streaks arrive first, then the lanterns tumble in, overshoot and wobble still.
  gust(b, i, to) {
    const from = { x: -b.w * (0.9 + i * 0.3), y: to.y + (Math.random() - 0.5) * 40 };
    gsap.set(b.bob, { rotation: 28 });
    return gsap.timeline({ delay: 0.3 + i * 0.07 })
      .add(along(b, t => [from.x + (to.x - from.x) * t, from.y + (to.y - from.y) * t], { duration: 1.05 + i * 0.08, ease: 'back.out(1.3)' }))
      .to(b.bob, { rotation: 0, duration: 1.8, ease: 'elastic.out(1, 0.35)' }, 0.5);
  },
  // Eddy swirl: an eddy spins each lantern in on a widening-to-tight spiral that ends at its spot.
  swirl(b, i, to) {
    const r0 = stage.clientWidth * 0.55 + i * 40, a0 = Math.PI + (Math.random() - 0.5) * 0.5, turn = -Math.PI * 1.3;
    gsap.set(b.bob, { rotation: -18 });
    return gsap.timeline({ delay: i * 0.14 })
      .add(along(b, t => {
        const r = r0 * Math.pow(1 - t, 1.6), a = a0 + turn * t;
        return [to.x + Math.cos(a) * r, to.y + Math.sin(a) * r * 0.5];
      }, { duration: 2.2 + i * 0.12, ease: 'sine.out' }))
      .to(b.bob, { rotation: 0, duration: 2, ease: 'sine.out' }, 0.4);
  },
  // The scene before the motion variants: a straight blow-in from the left.
  ''(b, i, to) {
    const from = { x: -b.w * (0.8 + i * 0.45), y: to.y + (Math.random() - 0.5) * 80 };
    return along(b, t => [from.x + (to.x - from.x) * t, from.y + (to.y - from.y) * t], { duration: 1.5 + i * 0.12, delay: i * 0.1, ease: 'power2.out' });
  },
};
const ENTER_GUST = { glide: [0.9, 2.4], gust: [1.4, 1.6], swirl: [0.8, 2.4], '': [0, 0] };

// Blowing out: the lanterns that weren't the answer leave downwind. `k` is the order the wind
// reaches them, left to right.
const EXIT = {
  glide(o, k) {
    const sx = o.x, sy = o.y, ex = stage.clientWidth + o.w * 1.5, rise = 70 + Math.random() * 60;
    return gsap.timeline({ delay: k * 0.12 })
      .to(o.bob, { rotation: -6, duration: 0.25, ease: 'sine.out' })
      .add(along(o, t => [sx + (ex - sx) * t, sy - Math.sin(t * Math.PI / 2) * rise], { duration: 1.6, ease: 'power2.in' }))
      .to(o.bob, { rotation: 20, duration: 1.4, ease: 'power1.in' }, '<');
  },
  gust(o, k) {
    const sx = o.x, sy = o.y, ex = stage.clientWidth + o.w * 1.5, dy = 20 + Math.random() * 40;
    return gsap.timeline({ delay: k * 0.05 })
      .add(along(o, t => [sx + (ex - sx) * t, sy - dy * t], { duration: 0.85, ease: 'power3.in' }))
      .to(o.bob, { rotation: 32, duration: 0.7, ease: 'power2.in' }, 0);
  },
  swirl(o, k) {
    const sx = o.x, sy = o.y, ex = stage.clientWidth * 0.9 + o.w, ey = -o.h * 1.5;
    return gsap.timeline({ delay: k * 0.1 })
      .add(along(o, t => [sx + (ex - sx) * Math.pow(t, 1.6) + Math.sin(t * Math.PI * 2) * 40 * (1 - t),
                          sy + (ey - sy) * Math.pow(t, 1.4)], { duration: 1.8, ease: 'sine.in' }))
      .to(o.bob, { rotation: 300, duration: 1.8, ease: 'sine.in' }, 0)
      .to(o.bob, { scale: 0.7, duration: 1.8, ease: 'sine.in' }, 0);
  },
  ''(o, k) {
    const sx = o.x, sy = o.y, ex = stage.clientWidth + o.w * 1.5, ey = o.y - 40 - Math.random() * 60;
    return gsap.timeline({ delay: k * 0.08 })
      .add(along(o, t => [sx + (ex - sx) * t, sy + (ey - sy) * t], { duration: 1.4, ease: 'power1.in' }))
      .to(o.bob, { rotation: 18, duration: 1.2, ease: 'power1.in' }, 0);
  },
};
const EXIT_GUST = { glide: [1.1, 2], gust: [1.6, 1.2], swirl: [0.9, 2], '': [0, 0] };

function spawnLanterns(options) {
  layer.innerHTML = '';
  lanterns = options.map((word, i) => makeLantern(word, i));
  // Land at random spots, each kept clear of the ones already chosen (best of a few
  // tries if the stage is too small to fit them all comfortably).
  const z = zone(lanterns[0]);
  const spots = [];
  lanterns.forEach(b => {
    let best = null, bestGap = -1;
    for (let n = 0; n < 40; n++) {
      const p = { x: z.minX + Math.random() * (z.maxX - z.minX), y: z.minY + Math.random() * (z.maxY - z.minY) };
      const gap = spots.length ? Math.min(...spots.map(s => Math.hypot(s.x - p.x, (s.y - p.y) * (b.w / b.h)))) : Infinity;
      if (gap > bestGap) { best = p; bestGap = gap; }
      if (gap >= b.w * 1.3) break;
    }
    spots.push(best);
    b.x = best.x; b.y = best.y;
    placeLantern(b);
  });
  if (!reduceMotion) {
    // Blown in on the wind from the left, then let go (how depends on the scene's motion).
    readMotion();
    const enter = ENTER[motion.kind] || ENTER[''], [peak, dur] = ENTER_GUST[motion.kind] || [0, 0];
    if (peak) gust(peak, dur);
    lanterns.forEach((b, i) => {
      const to = { x: b.x, y: b.y };
      b.entering = true;                 // still tappable while it blows in
      b.x = -b.w * 2; placeLantern(b);   // off stage until its tween starts
      b.blend = 0;
      b.enter = enter(b, i, to).eventCallback('onComplete', () => {
        b.entering = false;
        gsap.to(b, { blend: 1, duration: 2.5, ease: 'sine.inOut' });
      });
    });
  }
}

// ── Wind ────────────────────────────────────────────────────────────────
// A gusty breeze from the left: layered slow sines, so gusts build and fade.
// It leans every lantern, pushes its drift (less near the far edge, so they
// never pile up there) and draws faint streaks across the sky.
let windT = 0, wind = 0, nextStreak = 0, nextMotionRead = 0;
function windAt(t) { return Math.max(0, 0.5 + 0.5 * Math.sin(t * 0.29) * Math.sin(t * 0.131 + 1.3) + 0.15 * Math.sin(t * 0.83)); }
const windLayer = document.createElement('div');
windLayer.className = 'ws-wind';
windLayer.setAttribute('aria-hidden', 'true');
stage.insertBefore(windLayer, layer);
function windStreak() {
  const s = document.createElement('span');
  s.className = 'ws-wind-streak';
  const w = 80 + Math.random() * 120;
  s.style.cssText = `top:${(8 + Math.random() * 74).toFixed(1)}%;width:${w.toFixed(0)}px;`;
  windLayer.appendChild(s);
  gsap.timeline({ onComplete: () => s.remove() })
    .fromTo(s, { x: -w, opacity: 0 }, { x: stage.clientWidth + w, duration: 1.3 + Math.random() * 0.8, ease: 'none' })
    .to(s, { opacity: 0.25 + wind * 0.4, duration: 0.4, yoyo: true, repeat: 1, ease: 'sine.inOut' }, 0);
}

const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
function angleTo(from, to) { return Math.atan2(Math.sin(to - from), Math.cos(to - from)); }
let lastT = 0;
function tick(now) {
  const dt = Math.min(0.05, ((now - (lastT || now)) / 1000));
  lastT = now;
  if (!reduceMotion) {
    windT += dt;
    if (windT > nextMotionRead) { readMotion(); nextMotionRead = windT + 0.3; }
    wind = Math.min(2, windAt(windT) * motion.gust + gustBoost.v);
    if (windT > nextStreak && !document.hidden) {
      if (wind > 0.45) windStreak();
      nextStreak = windT + (gustBoost.v > 0.3 ? 0.1 + Math.random() * 0.15 : 0.5 + Math.random() * 0.9);
    }
  }
  const live = lanterns.filter(b => !b.flying && !b.entering);
  live.forEach(b => {
    const z = zone(b);
    if (!reduceMotion) {
      // Meander: the heading wanders a little; near an edge it turns home.
      b.heading += (Math.random() - 0.5) * 2.2 * dt;
      const m = b.w * 0.35;
      if (b.x < z.minX + m || b.x > z.maxX - m || b.y < z.minY + m * 0.6 || b.y > z.maxY - m * 0.6) {
        const home = Math.atan2((z.minY + z.maxY) / 2 - b.y, (z.minX + z.maxX) / 2 - b.x);
        b.heading += angleTo(b.heading, home) * Math.min(1, dt * 1.8);
      }
      // Avoid the others: steer away from any lantern that gets close, harder the closer it is.
      live.forEach(o => {
        if (o === b) return;
        const dx = o.x - b.x, dy = (o.y - b.y) * (b.w / b.h), d = Math.hypot(dx, dy), reach = b.w * 2;
        if (d < reach && d > 0.01) {
          const away = Math.atan2(-dy, -dx);
          b.heading += angleTo(b.heading, away) * Math.min(1, dt * 4 * (1 - d / reach));
        }
      });
      const target = b.held ? 0 : b.speed * motion.float * clamp(stage.clientWidth / 700, 0.7, 1.3);
      b.v += (target - b.v) * Math.min(1, dt * 2.5);
      b.x += Math.cos(b.heading) * b.v * dt;
      b.y += Math.sin(b.heading) * b.v * dt;
      if (b.kick) {                    // a wrong tap nudges the lantern away
        b.x += b.kick.vx * dt; b.y += b.kick.vy * dt;
        b.kick.vx *= 1 - Math.min(1, dt * 1.6); b.kick.vy *= 1 - Math.min(1, dt * 1.6);
        if (Math.hypot(b.kick.vx, b.kick.vy) < 2) b.kick = null;
      }
      // The wind pushes downwind, fading out over the last half of the stage.
      const room = clamp((z.maxX - b.x) / ((z.maxX - z.minX) * 0.5), 0, 1);
      b.x += wind * 22 * b.drag * room * dt;
      b.phase += dt * (1 + wind * 0.8);
      const lean = wind * 9 * b.drag + Math.sin(b.phase * 1.7) * (1.5 + wind * 3);
      // `blend` fades the bob and lean in after a glide-in, so the hand-off from the entry tween is gentle.
      const k = b.blend;
      b.bob.style.transform = `translateY(${(Math.sin(b.phase * 1.4) * (4 + wind * 2) * k).toFixed(2)}px) rotate(${(lean * k).toFixed(2)}deg)`;
    }
  });
  // Lanterns nudge each other apart instead of overlapping.
  for (let i = 0; i < live.length; i++) for (let j = i + 1; j < live.length; j++) {
    const a = live[i], c = live[j];
    const dx = c.x - a.x, dy = (c.y - a.y) * (a.w / a.h), d = Math.hypot(dx, dy), min = a.w * 1.04;
    if (d < min && d > 0.01) {
      const push = (min - d) / 2 * Math.min(1, dt * 8), nx = dx / d, ny = dy / d;
      a.x -= nx * push; a.y -= ny * push; c.x += nx * push; c.y += ny * push;
    }
  }
  live.forEach(b => { const z = zone(b); b.x = clamp(b.x, z.minX, z.maxX); b.y = clamp(b.y, z.minY, z.maxY); placeLantern(b); });
  requestAnimationFrame(tick);
}

// ── Questions ───────────────────────────────────────────────────────────
function optionsOf(q) {
  return (q.options || []).slice(0, 4);
}

async function loadQuestions() {
  // The lesson's deal: only questions with options, so every one has lanterns to float.
  const data = await GameKit.questions();
  questions = data ? data.questions : [];
  if (!questions.length) { showError(); return; }
  buildSky(questions.length);
  renderQuestion();
}
function showError() {
  document.getElementById('errorState').classList.remove('hidden');
  document.getElementById('questionCard').style.display = 'none';
}

function renderQuestion() {
  const q = questions[qi];
  firstTry = true;
  document.getElementById('questionPrompt').textContent =
    (q.question_prompt && q.question_prompt !== q.question_text) ? q.question_prompt : '';
  const textEl = document.getElementById('questionText');
  textEl.textContent = q.question_text || q.question_prompt || '';
  if (window.renderMathInElement) renderMathInElement(textEl, { delimiters: [{ left: '$', right: '$', display: false }] });
  GameKit.progress({
    label: T.questionOf.replace('{current}', qi + 1).replace('{total}', questions.length),
    fraction: qi / questions.length,
  });
  spawnLanterns(GameKit.shuffle(optionsOf(q)));
  layer.classList.remove('is-busy');
  mode = 'question';
}

async function onLantern(b) {
  if (mode !== 'question' || b.flying) return;
  const q = questions[qi];
  mode = 'busy';
  GameKit.speak(b.word);
  const isCorrect = await GameKit.check(q.id, b.word);
  if (isCorrect === null) {
    // The check never reached the server: not a wrong lantern, just ask again.
    showHint(T.checkFailed);
    mode = 'question';
    return;
  }
  GameKit.track('game_answer', { question_id: q.id, is_correct: isCorrect, first_try: firstTry });

  if (!isCorrect) {
    firstTry = false;
    streak = 0;
    showStreak();
    b.el.classList.add('is-tried');
    // Drift away and dim, then wander back: it stays in the stage and stays tappable.
    const away = Math.atan2(b.y - stage.clientHeight / 2, b.x - stage.clientWidth / 2);
    if (!reduceMotion) {
      b.kick = { vx: Math.cos(away) * 70, vy: Math.sin(away) * 70 + 20 };
      // Web Animations, not GSAP: GSAP would fold the lantern's `translate` into its own transform and make it jump.
      b.el.animate([{ rotate: '0deg' }, { rotate: '7deg' }], { duration: 80, iterations: 6, direction: 'alternate', easing: 'ease-in-out' });
    }
    showHint();
    mode = 'question';
    return;
  }

  if (firstTry) { streak++; } else { streak = 0; }
  showStreak();
  layer.classList.add('is-busy');
  riseToStar(b, firstTry);
}

function riseToStar(b, gold) {
  lanterns.forEach(o => { if (o.enter) o.enter.kill(); o.entering = false; });
  b.flying = true;
  b.el.classList.add('is-right');
  // The others are blown away downwind; the right one rises into the sky.
  readMotion();
  const exit = EXIT[motion.kind] || EXIT[''], [peak, dur] = EXIT_GUST[motion.kind] || [0, 0];
  if (peak && !reduceMotion) gust(peak, dur);
  lanterns.filter(o => o !== b).sort((p, q) => p.x - q.x).forEach((o, k) => {
    o.flying = true;
    if (reduceMotion) { gsap.to(o.el, { opacity: 0, duration: 0.2 }); return; }
    exit(o, k);
  });
  const target = skyPointOnStage(starPts[lit]);
  const done = () => {
    spawnBurst(target.x, target.y, gold ? '253,230,138' : '255,255,255', 26);
    lightStar(gold);
    b.el.remove();
    gsap.delayedCall(reduceMotion ? 0.4 : 0.9, nextQuestion);
  };
  if (reduceMotion) { gsap.to(b.el, { opacity: 0, duration: 0.25, onComplete: done }); return; }
  const from = { x: b.x, y: b.y };
  gsap.timeline({ onComplete: done })
    .to(b.bob, { scale: 1.08, duration: 0.18, ease: 'power2.out' })
    .to(from, {
      x: target.x, y: target.y, duration: 1.1, ease: 'power2.inOut',
      onUpdate: () => { b.x = from.x; b.y = from.y; placeLantern(b); },
    }, '>')
    .to(b.bob, { scale: 0.18, duration: 1.1, ease: 'power2.in' }, '<')
    .to(b.el, { opacity: 0.2, duration: 1.1, ease: 'power2.in' }, '<');
}

function nextQuestion() {
  qi++;
  if (qi >= questions.length) { finishGame(); return; }
  renderQuestion();
  GameKit.speakQuestion(questions[qi]);
}

function showStreak() {
  const el = document.getElementById('streakNote');
  if (streak >= 2) {
    el.textContent = T.streak.replace('{n}', streak);
    el.hidden = false;
    if (!reduceMotion) gsap.fromTo(el, { y: 6, opacity: 0 }, { y: 0, opacity: 1, duration: 0.3, ease: 'back.out(2)' });
  } else el.hidden = true;
}
function showHint(text) {
  const hint = document.getElementById('tryAgain');
  if (!hint.dataset.text) hint.dataset.text = hint.textContent;
  hint.textContent = text || hint.dataset.text;
  gsap.killTweensOf(hint);
  gsap.fromTo(hint, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.25, onComplete: () => gsap.to(hint, { opacity: 0, delay: 1.3 }) });
}

// ── Finish: the last line closes the bird and it lights up ──────────────
async function finishGame() {
  mode = 'done';
  layer.innerHTML = '';
  lanterns = [];
  GameKit.progress({ label: T.allDone, fraction: 1 });
  if (starPts.length > 2) drawLine(starPts[starPts.length - 1], starPts[0], 'ws-sky-line-closing');
  gsap.to('#skyFigure', { opacity: 0.22, duration: reduceMotion ? 0.2 : 1.4, delay: 0.4, ease: 'sine.inOut' });
  if (!reduceMotion) {
    gsap.to('#skyStars g', { scale: 1.5, transformOrigin: '50% 50%', duration: 0.35, yoyo: true, repeat: 1, stagger: 0.08, delay: 0.3 });
    starPts.forEach((p, i) => gsap.delayedCall(0.3 + i * 0.08, () => { const s = skyPointOnStage(p); spawnBurst(s.x, s.y, '253,230,138', 10); }));
    gsap.to(sky, { y: -6, duration: 2.2, yoyo: true, repeat: -1, ease: 'sine.inOut', delay: 1.6 });
  }

  await GameKit.finish({}, { after: 2400 });
}

// ── Start ───────────────────────────────────────────────────────────────
window.addEventListener('resize', () => {
  sizeCanvas();
  lanterns.forEach(b => { if (!b.flying) sizeLantern(b); });
});
// Words are measured to fit their lantern; measure again once Baloo 2 has loaded.
if (document.fonts) document.fonts.ready.then(() => lanterns.forEach(b => { if (!b.flying) sizeLantern(b); }));
sizeCanvas();
requestAnimationFrame(tick);
loadQuestions();
</script>
</GamePage>
