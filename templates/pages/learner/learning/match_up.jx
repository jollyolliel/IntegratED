{#- Match Up: the train builder. Tap a word on the left, then its partner on the right; every pair
    matched couples a carriage (labelled with the pair) onto the little steam train, and the
    finished train chugs away. A wrong pair just wobbles apart — no lives, no timer. Score counts
    pairs matched first time. The scene (.mu-world: valley, dunes or night sky, by lesson id) is
    decoration only — no ids, no JS hooks; the train layer between its back and front SVGs is
    what the script draws. -#}
{#import "@components/shell/game_page.jx" as GamePage #}
{#import "@components/audio_button.jx" as AudioButton #}
{#import "@components/base/button.jx" as Button #}
{#def lesson, already_completed=False #}
<GamePage title={{ t('learner.match_up.title') ~ ' — ' ~ lesson.title ~ ' - IntegratED' }} lesson={{ lesson }} styles="game-match-up">
  <main class="mu-layout" id="page-content">

    <div class="mu-topbar">
      <div class="flex items-center gap-2">
        <span class="mu-title-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18"><path d="M4 15V8a3 3 0 0 1 3-3h7v10Z" fill="currentColor"/><path d="M14 9h4l2 3v3h-6Z" fill="currentColor" opacity=".7"/><circle cx="8" cy="17" r="2.2" fill="currentColor"/><circle cx="16.5" cy="17" r="2.2" fill="currentColor"/></svg>
        </span>
        <h1 class="display-font font-bold text-sm text-sky-700 uppercase tracking-widest">{{ t('learner.match_up.title') }}</h1>
      </div>
      <div class="mu-progress">
        <div class="mu-progress-labels">
          <span id="progressLabel" class="text-xs font-bold text-ink-muted font-mono">—</span>
          <span id="streakNote" class="mu-streak" hidden></span>
        </div>
        <div class="progress-track"><div id="progressFill" class="progress-fill" style="width:0%"></div></div>
      </div>
    </div>

    {% if already_completed %}
    <div class="rounded-2xl px-4 py-2.5 text-sm font-semibold bg-amber-100 border-2 border-amber-300 text-amber-800">
      {{ t('learner.match_up.already_completed') }} {{ t('learner.match_up.replay_no_xp') }}
    </div>
    {% endif %}

    <div id="errorState" class="hidden py-10 text-center rounded-2xl p-6 bg-red-50 border-2 border-red-200">
      <p class="text-danger font-bold mb-4">{{ t('learner.match_up.load_failed') }}</p>
      <Button variant="danger" onclick="location.reload()">{{ t('learner.match_up.reload') }}</Button>
    </div>

    <!-- ═══ The valley and the train ═══ -->
    <section class="mu-scene" id="muScene">
      <div class="mu-world" aria-hidden="true">
        {#- One of three scenes, picked by lesson id so a lesson always shows the same one:
            remainder 1 the morning valley, 2 the golden dunes, 0 the starry night. -#}
        {% set scene = lesson.id % 3 %}
        {% if scene == 1 %}
          <svg class="mu-back" viewBox="0 0 1200 400" preserveAspectRatio="xMidYMax slice" aria-hidden="true"><defs><linearGradient id="mum-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#9ED8F0"/><stop offset="0.62" stop-color="#D4EEF5"/><stop offset="1" stop-color="#FBEFD5"/></linearGradient><radialGradient id="mum-glow"><stop offset="0" stop-color="#FFF0C0" stop-opacity="0.95"/><stop offset="0.4" stop-color="#FFF0C0" stop-opacity="0.4"/><stop offset="1" stop-color="#FFF0C0" stop-opacity="0"/></radialGradient><pattern id="mum-sleepers" width="22" height="8" patternUnits="userSpaceOnUse"><rect width="12" height="7" rx="1.5" fill="#8A6A48"/></pattern></defs><rect width="1200" height="400" fill="url(#mum-sky)"/><circle cx="930" cy="96" r="150" fill="url(#mum-glow)"/><circle cx="930" cy="96" r="40" fill="#FFF4CF"/><g class="mu-drift" style="--dr:70s" transform="translate(170 92) scale(1.0)"><path d="M-70 18 C-72 2 -54 -6 -40 0 C-34 -18 -6 -24 8 -10 C18 -22 46 -18 50 0 C66 -2 78 8 72 18Z" fill="#FFFFFF" opacity="0.95"/></g><g class="mu-drift" style="--dr:90s" transform="translate(560 60) scale(0.75)"><path d="M-70 18 C-72 2 -54 -6 -40 0 C-34 -18 -6 -24 8 -10 C18 -22 46 -18 50 0 C66 -2 78 8 72 18Z" fill="#FFFFFF" opacity="0.95"/></g><g class="mu-drift" style="--dr:80s" transform="translate(1060 150) scale(0.9)"><path d="M-70 18 C-72 2 -54 -6 -40 0 C-34 -18 -6 -24 8 -10 C18 -22 46 -18 50 0 C66 -2 78 8 72 18Z" fill="#FFFFFF" opacity="0.95"/></g><path d="M0 236 L90 176 L170 214 L270 128 L370 206 L460 158 L570 218 L670 142 L770 206 L870 134 L990 214 L1090 166 L1200 206 V400 H0Z" fill="#B4D3DE"/><path d="M90 176 L31 245 L96 246Z" fill="#CBE3EA"/><path d="M270 128 L205 214 L276 198Z" fill="#CBE3EA"/><path d="M460 158 L402 219 L466 228Z" fill="#CBE3EA"/><path d="M670 142 L605 221 L676 212Z" fill="#CBE3EA"/><path d="M870 134 L805 211 L876 204Z" fill="#CBE3EA"/><path d="M1090 166 L1025 227 L1096 236Z" fill="#CBE3EA"/><path d="M0 262 C120 222 220 242 320 234 C430 2