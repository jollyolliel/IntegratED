          <svg class="mu-front" viewBox="0 0 1200 400" preserveAspectRatio="xMidYMax slice" aria-hidden="true"><path d="M-20 400 C-30 360 -6 330 30 336 C40 312 80 310 96 334 C120 330 140 352 134 372 C150 380 150 400 150 400Z" fill="#0F2417"/><path d="M-20 400 C-24 372 -4 352 24 356 C34 338 66 336 80 356 C96 356 110 372 104 400Z" fill="#16301F"/><path d="M1220 400 C1230 356 1200 332 1170 342 C1158 320 1120 322 1110 344 C1086 342 1070 364 1078 400Z" fill="#0F2417"/><path d="M1220 400 C1222 374 1204 360 1180 364 C1170 350 1144 350 1136 368 C1120 370 1112 386 1118 400Z" fill="#16301F"/><path class="mu-sway" style="--sw:5.9s" d="M120 400 q2 -13 -4 -21 q8 8 9 21 q1 -15 7 -23 q-2 13 1 23Z" fill="#0F2417"/><path class="mu-sway" style="--sw:3.9s" d="M149 400 q2 -14 -4 -23 q8 9 9 23 q1 -16 7 -25 q-2 14 1 25Z" fill="#16301F"/><path class="mu-sway" style="--sw:3.4s" d="M196 400 q2 -8 -4 -13 q8 5 9 13 q1 -9 7 -14 q-2 8 1 14Z" fill="#0F2417"/><path class="mu-sway" style="--sw:3.4s" d="M246 400 q2 -12 -4 -19 q8 8 9 19 q1 -14 7 -21 q-2 12 1 21Z" fill="#0F2417"/><circle cx="248" cy="377" r="3.2" fill="#FDE68A"/><path class="mu-sway" style="--sw:3.7s" d="M305 400 q2 -8 -4 -13 q8 5 9 13 q1 -9 7 -15 q-2 8 1 15Z" fill="#0F2417"/><circle cx="307" cy="383" r="3.2" fill="#FFFFFF"/><path class="mu-sway" style="--sw:5.3s" d="M341 400 q2 -11 -4 -18 q8 7 9 18 q1 -12 7 -19 q-2 11 1 19Z" fill="#16301F"/><path class="mu-sway" style="--sw:3.9s" d="M370 400 q2 -11 -4 -18 q8 7 9 18 q1 -12 7 -19 q-2 11 1 19Z" fill="#16301F"/><path class="mu-sway" style="--sw:3.8s" d="M429 400 q2 -10 -4 -17 q8 7 9 17 q1 -12 7 -19 q-2 10 1 19Z" fill="#16301F"/><path class="mu-sway" style="--sw:3.3s" d="M486 400 q2 -8 -4 -13 q8 5 9 13 q1 -9 7 -14 q-2 8 1 14Z" fill="#0F2417"/><path class="mu-sway" style="--sw:4.5s" d="M517 400 q2 -13 -4 -22 q8 9 9 22 q1 -15 7 -24 q-2 13 1 24Z" fill="#16301F"/><path class="mu-sway" style="--sw:4.5s" d="M551 400 q2 -14 -4 -23 q8 9 9 23 q1 -16 7 -25 q-2 14 1 25Z" fill="#16301F"/><circle cx="553" cy="373" r="3.2" fill="#FDE68A"/><path class="mu-sway" style="--sw:5.2s" d="M600 400 q2 -10 -4 -17 q8 7 9 17 q1 -12 7 -19 q-2 10 1 19Z" fill="#0F2417"/><path class="mu-sway" style="--sw:3.0s" d="M637 400 q2 -13 -4 -22 q8 9 9 22 q1 -15 7 -24 q-2 13 1 24Z" fill="#0F2417"/><path class="mu-sway" style="--sw:5.1s" d="M667 400 q2 -14 -4 -23 q8 9 9 23 q1 -16 7 -25 q-2 14 1 25Z" fill="#0F2417"/><circle cx="669" cy="373" r="3.2" fill="#C4B5FD"/><path class="mu-sway" style="--sw:4.8s" d="M706 400 q2 -14 -4 -24 q8 10 9 24 q1 -17 7 -26 q-2 14 1 26Z" fill="#0F2417"/><path class="mu-sway" style="--sw:3.8s" d="M758 400 q2 -13 -4 -22 q8 9 9 22 q1 -16 7 -24 q-2 13 1 24Z" fill="#16301F"/><path class="mu-sway" style="--sw:3.7s" d="M793 400 q2 -14 -4 -23 q8 9 9 23 q1 -16 7 -26 q-2 14 1 26Z" fill="#0F2417"/><path class="mu-sway" style="--sw:5.4s" d="M830 400 q2 -13 -4 -21 q8 9 9 21 q1 -15 7 -23 q-2 13 1 23Z" fill="#0F2417"/><path class="mu-sway" style="--sw:5.7s" d="M884 400 q2 -12 -4 -20 q8 8 9 20 q1 -14 7 -22 q-2 12 1 22Z" fill="#16301F"/><path class="mu-sway" style="--sw:4.4s" d="M911 400 q2 -12 -4 -21 q8 8 9 21 q1 -15 7 -23 q-2 12 1 23Z" fill="#16301F"/><path class="mu-sway" style="--sw:5.8s" d="M947 400 q2 -8 -4 -13 q8 5 9 13 q1 -9 7 -14 q-2 8 1 14Z" fill="#16301F"/><circle cx="949" cy="383" r="3.2" fill="#FDE68A"/><path class="mu-sway" style="--sw:5.2s" d="M985 400 q2 -9 -4 -16 q8 6 9 16 q1 -11 7 -17 q-2 9 1 17Z" fill="#0F2417"/><path class="mu-sway" style="--sw:5.0s" d="M1019 400 q2 -11 -4 -18 q8 7 9 18 q1 -12 7 -20 q-2 11 1 20Z" fill="#16301F"/><circle cx="1021" cy="378" r="3.2" fill="#C4B5FD"/><path class="mu-sway" style="--sw:5.4s" d="M1048 400 q2 -11 -4 -18 q8 7 9 18 q1 -13 7 -20 q-2 11 1 20Z" fill="#16301F"/><path class="mu-sway" style="--sw:4.3s" d="M1085 400 q2 -13 -4 -21 q8 8 9 21 q1 -15 7 -23 q-2 13 1 23Z" fill="#16301F"/><circle cx="1087" cy="375" r="3.2" fill="#C4B5FD"/></svg>
        {% endif %}
      </div>
      <svg class="mu-train-layer" id="muTrain" viewBox="0 0 1200 400" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        <g id="muFit">
        <g id="muSlots"></g>
        <g id="muTrainGroup">
          <g id="muCars"></g>
          <g id="muHero">
            <!-- The engine, facing right; its wheels stand on the rail (local y = 0). -->
            <g class="mu-loco-body">
              <rect x="-6" y="-122" width="70" height="14" rx="5" fill="#2F3A5A"/>
              <rect x="0" y="-110" width="58" height="84" rx="6" fill="#E9574C"/>
              <rect x="40" y="-110" width="18" height="84" rx="4" fill="#C9433D"/>
              <rect x="11" y="-100" width="34" height="32" rx="9" fill="#BFE8FF"/>
              <g class="mu-driver">
                <circle cx="28" cy="-79" r="10.5" fill="#B9774C"/>
                <path d="M17.5 -81 C17 -92 26 -95 33 -92 C38 -90 40 -85 38.5 -81 C35 -86 27 -88 17.5 -81Z" fill="#2B1B12"/>
                <circle cx="31" cy="-79" r="1.6" fill="#1E1B4B"/><circle cx="24" cy="-79" r="1.6" fill="#1E1B4B"/>
                <path d="M24.5 -74.5 Q28 -72 31 -74.5" stroke="#1E1B4B" stroke-width="1.4" fill="none" stroke-linecap="round"/>
                <g class="mu-arm"><path d="M36 -70 L46 -88" stroke="#B9774C" stroke-width="5" stroke-linecap="round"/><circle cx="46.5" cy="-89" r="3.6" fill="#B9774C"/></g>
              </g>
              <rect x="52" y="-86" width="118" height="56" rx="26" fill="#2E7FC0"/>
              <path d="M52 -58 H170 V-56 C170 -42 160 -30 144 -30 H78 C62 -30 52 -42 52 -58Z" fill="#256AA3"/>
              <rect x="66" y="-80" width="88" height="5" rx="2.5" fill="#FFFFFF" opacity=".35"/>
              <rect x="84" y="-86" width="7" height="56" fill="#F5C443"/>
              <rect x="124" y="-86" width="7" height="56" fill="#F5C443"/>
              <path d="M96 -86 A13 13 0 0 1 122 -86Z" fill="#F5C443"/>
              <path d="M138 -86 V-112 H134 V-122 H162 V-112 H158 V-86Z" fill="#2F3A5A"/>
              <rect x="134" y="-122" width="28" height="4" fill="#4A5680"/>
              <rect x="164" y="-82" width="16" height="50" rx="5" fill="#2F3A5A"/>
              <circle cx="181" cy="-70" r="7" fill="#FFE59A"/><circle cx="181" cy="-70" r="3.5" fill="#FFFFFF"/>
              <rect x="-6" y="-32" width="194" height="12" rx="4" fill="#2F3A5A"/>
              <path d="M184 -30 L204 -2 H178Z" fill="#F5C443"/>
            </g>
            <g class="mu-wheels">
              <g class="mu-wheel" transform="translate(30 -22)"><circle r="22" fill="#2F3A5A"/><circle r="15" fill="#E9574C"/><g class="mu-spokes"><path d="M-15 0 H15 M0 -15 V15 M-10.6 -10.6 L10.6 10.6 M-10.6 10.6 L10.6 -10.6" stroke="#2F3A5A" stroke-width="3"/></g><circle r="5" fill="#F5C443"/></g>
              <g class="mu-wheel" transform="translate(98 -17)"><circle r="17" fill="#2F3A5A"/><circle r="11" fill="#E9574C"/><g class="mu-spokes"><path d="M-11 0 H11 M0 -11 V11" stroke="#2F3A5A" stroke-width="3"/></g><circle r="4" fill="#F5C443"/></g>
              <g class="mu-wheel" transform="translate(146 -17)"><circle r="17" fill="#2F3A5A"/><circle r="11" fill="#E9574C"/><g class="mu-spokes"><path d="M-11 0 H11 M0 -11 V11" stroke="#2F3A5A" stroke-width="3"/></g><circle r="4" fill="#F5C443"/></g>
              <rect x="30" y="-21" width="116" height="5" rx="2.5" fill="#F5C443"/>
            </g>
          </g>
        </g>
        <g id="muSmoke"></g>
        </g>
      </svg>
      <p id="sceneStatus" class="sr-only" aria-live="polite"></p>
    </section>

    <!-- ═══ The board ═══ -->
    <section class="mu-board" id="muBoard" hidden>
      <div class="mu-instruct">
        <AudioButton id="speakerBtn" label={{ t('learner.match_up.read_aloud') }} />
        <p class="display-font">{{ t('learner.match_up.instruction') }}</p>
      </div>
      <div class="mu-columns">
        <div class="mu-col" id="muLeft"></div>
        <div class="mu-col" id="muRight"></div>
      </div>
    </section>
  </main>

  <div class="game-hint-toast" id="tryAgain">{{ t('learner.match_up.try_again') }}</div>

<script>
// ============================================================
// Match Up — the train builder. Pairs come from the lesson's match
// questions. Tap a left word then its right partner (either order
// works); a right pair couples a carriage onto the train.
// ============================================================
const lessonId = {{ lesson.id }};
GameKit.init({ lessonId, game: 'match_up' });
const T = {
  progress:    {{ t('learner.match_up.progress') | tojson }},
  allMatched:  {{ t('learner.match_up.all_matched') | tojson }},
  streak:      {{ t('learner.match_up.streak') | tojson }},
  instruction: {{ t('learner.match_up.instruction') | tojson }},
  sceneStatus: {{ t('learner.match_up.scene_status') | tojson }},
  checkFailed: {{ t('learner.game.check_failed') | tojson }},
};
// One colour per carriage; a matched pair's two tiles take its carriage's colour.
const CAR_COLORS = [
  ["#F59E0B", "#D97706"], ["#10B981", "#059669"], ["#8B5CF6", "#7C3AED"],
  ["#EC4899", "#DB2777"], ["#0EA5E9", "#0284C7"], ["#F97316", "#EA580C"],
];
const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
const NS = "http://www.w3.org/2000/svg";

let lefts = [], rights = []; // the words, unpaired: the server holds which goes with which
let matched = 0;
let streak = 0;
const missed = new Set();  // left indexes that were part of a wrong try
let pickLeft = null, pickRight = null;
let landing = 0;          // carriages still flying in; tapping never waits for them
let finished = false;
let checking = false;     // a pair is with the server; taps wait for its answer
let geo = null;

const trainSvg = document.getElementById("muTrain");
const trainGroup = document.getElementById("muTrainGroup");
const carsG = document.getElementById("muCars");
const slotsG = document.getElementById("muSlots");
const hero = document.getElementById("muHero");
const leftCol = document.getElementById("muLeft");
const rightCol = document.getElementById("muRight");

document.getElementById("speakerBtn").addEventListener("click", () => GameKit.speak(T.instruction));

// Flying tile clones are positioned in page coordinates on <body>, read once
// at the start, so they land right even if the learner scrolls mid-flight.
function pageRect(el) {
  const r = el.getBoundingClientRect();
  return { left: r.left + window.scrollX, top: r.top + window.scrollY, width: r.width, height: r.height };
}

// ── The train ───────────────────────────────────────────────────────────
// The rail top is y=326. The engine is 196 long (plus its cowcatcher);
// carriages queue behind it (to its left), car 0 coupled first. The train
// is laid out for the middle 880 units, then #muFit scales it down about
// the rail's centre when the scene is narrower than that (phones).
const RAIL_Y = 326, LOCO_LEN = 196, GAP = 6, TRAIN_SPAN = 880;
function computeGeometry(n) {
  const carW = Math.min(108, (TRAIN_SPAN - LOCO_LEN) / n - GAP);
  const total = n * (carW + GAP) + LOCO_LEN + 10;
  const x0 = (1200 - total) / 2;
  return { n, carW, locoX: x0 + n * (carW + GAP), carX: k => x0 + (n - 1 - k) * (carW + GAP) };
}
// The scene is "slice"-scaled by its height, so it shows 400 × aspect units across.
function fitTrain() {
  const r = trainSvg.getBoundingClientRect();
  if (!r.height) return;
  const visible = Math.min(1200, 400 * r.width / r.height);
  const s = Math.min(1, (visible - 70) / TRAIN_SPAN);
  document.getElementById("muFit").setAttribute("transform", `translate(600 ${RAIL_Y}) scale(${s.toFixed(3)}) translate(-600 ${-RAIL_Y})`);
}
window.addEventListener("resize", fitTrain);

function el(tag, attrs, parent) {
  const e = document.createElementNS(NS, tag);
  for (const k in attrs) e.setAttribute(k, attrs[k]);
  if (parent) parent.appendChild(e);
  return e;
}

function buildSlots() {
  slotsG.innerHTML = "";
  for (let k = 0; k < geo.n; k++) {
    el("rect", { class: "mu-slot", x: geo.carX(k) + 3, y: RAIL_Y - 74, width: geo.carW - 6, height: 62, rx: 10 }, slotsG);
  }
  hero.setAttribute("transform", `translate(${geo.locoX} ${RAIL_Y})`);
}

// A carriage: a rounded body in the pair's colour, a cream window band with
// the pair written on it, a roof, two wheels and a coupling bar.
function carriage(k, pair) {
  const [c, shade] = CAR_COLORS[k % CAR_COLORS.length];
  const w = geo.carW;
  const g = el("g", { class: "mu-car", transform: `translate(${geo.carX(k)} ${RAIL_Y})` });
  const inner = el("g", { class: "mu-car-inner" }, g);
  el("rect", { x: w - 2, y: -30, width: GAP + 6, height: 5, rx: 2, fill: "#2F3A5A" }, inner);
  el("rect", { x: 0, y: -84, width: w, height: 12, rx: 5, fill: shade }, inner);
  el("rect", { x: 3, y: -74, width: w - 6, height: 54, rx: 9, fill: c }, inner);
  el("rect", { x: w * 0.62, y: -74, width: w * 0.38 - 3, height: 54, rx: 9, fill: shade, opacity: 0.45 }, inner);
  el("rect", { x: 10, y: -66, width: w - 20, height: 26, rx: 7, fill: "#FFF8EA" }, inner);
  const label = pair.left + " · " + pair.right;
  const fs = Math.min(16, (w - 26) / (label.length * 0.52));
  const txt = el("text", { x: w / 2, y: -48.5, "text-anchor": "middle", "font-size": fs.toFixed(1), class: "mu-car-text" }, inner);
  txt.textContent = label;
  el("rect", { x: 6, y: -24, width: w - 12, height: 6, rx: 3, fill: "#2F3A5A" }, inner);
  [w * 0.24, w * 0.76].forEach(x => {
    const wh = el("g", { class: "mu-wheel", transform: `translate(${x} -11)` }, inner);
    el("circle", { r: 11, fill: "#2F3A5A" }, wh);
    el("circle", { r: 6.5, fill: shade }, wh);
    const sp = el("g", { class: "mu-spokes" }, wh);
    el("path", { d: "M-6.5 0 H6.5 M0 -6.5 V6.5", stroke: "#2F3A5A", "stroke-width": 2.2 }, sp);
    el("circle", { r: 2.4, fill: "#F5C443" }, wh);
  });
  carsG.appendChild(g);
  return g;
}

function smokePuff(n = 3, big = false) {
  if (reduceMotion) return;
  const smoke = document.getElementById("muSmoke");
  const m = trainGroup.transform.baseVal.consolidate();
  const dx = m ? m.matrix.e : 0;
  for (let k = 0; k < n; k++) {
    const c = el("circle", { cx: geo.locoX + 148 + dx, cy: RAIL_Y - 126, r: big ? 12 : 9, class: "mu-puff" }, smoke);
    gsap.to(c, {
      attr: { cy: RAIL_Y - 190 - Math.random() * 40, cx: geo.locoX + 140 + dx - 30 - Math.random() * 40, r: (big ? 30 : 22) + Math.random() * 10 },
      opacity: 0, duration: 1.4 + Math.random() * 0.5, delay: k * 0.18, ease: "power1.out", onComplete: () => c.remove(),
    });
  }
}
function idlePuffs() {
  if (reduceMotion) return;
  setInterval(() => { if (!document.hidden && !landing && !finished) smokePuff(1); }, 1700);
}

// ── Load ────────────────────────────────────────────────────────────────
async function loadPairs() {
  // The lesson's deal is its match questions; the server sends each one's right column shuffled.
  const data = await GameKit.questions();
  (data ? data.questions : []).forEach(q => {
    lefts.push(...(q.match_left || []));
    rights.push(...(q.match_right || []));
  });
  if (!lefts.length) { document.getElementById("errorState").classList.remove("hidden"); return; }
  geo = computeGeometry(lefts.length);
  buildSlots();
  fitTrain();
  renderBoard();
  updateProgress();
  idlePuffs();
}

// ── Board ───────────────────────────────────────────────────────────────

function tile(word, side, idx) {
  const b = document.createElement("button");
  b.type = "button";
  b.className = "quick-action-card mu-tile mu-tile-" + side;
  b.dataset.idx = idx;
  b.innerHTML = `<span class="mu-tile-word"></span><span class="mu-tile-mark" aria-hidden="true"></span>`;
  b.querySelector(".mu-tile-word").textContent = word;
  b.setAttribute("aria-pressed", "false");
  b.addEventListener("click", () => onTile(b, side, idx));
  return b;
}

// Both columns share one CSS grid; a tile's row is its place in its column's DOM order.
function setRows(col) { [...col.children].forEach((t, r) => { t.style.gridRow = String(r + 1); }); }

function renderBoard() {
  document.getElementById("muBoard").hidden = false;
  leftCol.innerHTML = ""; rightCol.innerHTML = "";
  lefts.forEach((word, i) => leftCol.appendChild(tile(word, "left", i)));
  rights.forEach((word, i) => rightCol.appendChild(tile(word, "right", i)));
  setRows(leftCol); setRows(rightCol);
  if (!reduceMotion) gsap.from([...leftCol.children, ...rightCol.children], { y: 14, opacity: 0, stagger: 0.04, duration: 0.3, ease: "back.out(1.6)", clearProps: "transform,translate,opacity" });
}

function updateProgress() {
  const n = lefts.length;
  GameKit.progress({
    label: matched >= n ? T.allMatched : T.progress.replace("{done}", matched).replace("{total}", n),
    fraction: matched / n,
    streak, streakText: T.streak.replace("{n}", streak),
  });
  document.getElementById("sceneStatus").textContent = T.sceneStatus.replace("{done}", matched).replace("{total}", n);
}

function setPick(side, b) {
  const cur = side === "left" ? pickLeft : pickRight;
  if (cur) { cur.classList.remove("is-picked"); cur.setAttribute("aria-pressed", "false"); }
  if (b) { b.classList.add("is-picked"); b.setAttribute("aria-pressed", "true"); }
  if (side === "left") pickLeft = b; else pickRight = b;
}

function onTile(b, side, idx) {
  if (finished || checking || b.classList.contains("is-matched")) return;
  GameKit.speak(b.querySelector(".mu-tile-word").textContent);
  const cur = side === "left" ? pickLeft : pickRight;
  setPick(side, cur === b ? null : b);   // tapping the picked tile again un-picks it
  if (!reduceMotion && cur !== b) gsap.fromTo(b, { scale: 0.96 }, { scale: 1, duration: 0.25, ease: "back.out(3)", clearProps: "transform,scale" });
  if (pickLeft && pickRight) tryPair();
}

async function tryPair() {
  const L = pickLeft, R = pickRight;
  const li = +L.dataset.idx, ri = +R.dataset.idx;
  setPick("left", null); setPick("right", null);
  // The server checks the pair and logs the try; the score comes from its log, not this page.
  checking = true;
  const ok = await GameKit.checkPair(lefts[li], rights[ri]);
  checking = false;
  if (ok === null) {
    showHint(T.checkFailed);   // nothing judged — the learner just tries again
    return;
  }
  GameKit.track('game_answer', { is_correct: ok, first_try: !missed.has(li) });
  if (!ok) {
    missed.add(li);
    streak = 0;
    updateProgress();
    [L, R].forEach(t => {
      t.classList.add("is-wrong");
      if (!reduceMotion) gsap.fromTo(t, { x: 0 }, { x: 7, duration: 0.06, repeat: 5, yoyo: true, ease: "power1.inOut", clearProps: "transform,translate" });
      setTimeout(() => t.classList.remove("is-wrong"), 700);
    });
    showHint();
    return;
  }
  if (!missed.has(li)) { streak++; } else { streak = 0; }
  const k = matched++;
  const [c] = CAR_COLORS[k % CAR_COLORS.length];
  [L, R].forEach(t => { t.classList.add("is-matched"); t.disabled = true; t.style.setProperty("--pc", c); });
  updateProgress();
  const pair = { left: lefts[li], right: rights[ri] };
  landing++;   // counted now, so the game can't finish while this carriage waits its turn
  // Slide the right tile beside its partner, then both fly up into the train.
  connectPair(L, R, 420).then(() => coupleCarriage(k, pair, () => [cloneFlyer(L), cloneFlyer(R)]));
}

// Slide the matched right tile onto its left partner's row, swapping with whichever
// tile is there. That tile is never already matched: a matched right tile sits on
// its own partner's row, and this left tile had no partner until now. FLIP with
// the Web Animations `translate` property, which the clay card's transform
// transition and the gsap tweens on `transform` don't touch. Resolves once the
// pair sits side by side and the bridge between them starts to draw.
function connectPair(L, R, ms) {
  const join = () => { L.classList.add("is-joined"); };
  const rights = [...rightCol.children];
  const from = rights.indexOf(R), to = [...leftCol.children].indexOf(L);
  if (from === to) { join(); return Promise.resolve(); }
  const other = rights[to];
  const before = new Map([R, other].map(t => [t, t.getBoundingClientRect()]));
  rights[to] = R; rights[from] = other;
  const focused = document.activeElement;
  rights.forEach(t => rightCol.appendChild(t));   // DOM order follows rows, so Tab order does too
  if (focused && rightCol.contains(focused) && document.activeElement !== focused) focused.focus({ preventScroll: true });
  setRows(rightCol);
  if (reduceMotion) { join(); return Promise.resolve(); }
  const anims = [...before].map(([t, r]) => {
    const now = t.getBoundingClientRect();
    return t.animate([{ translate: `${r.left - now.left}px ${r.top - now.top}px` }, { translate: "0 0" }],
      { duration: ms, easing: "cubic-bezier(.3,1.25,.5,1)" }).finished;
  });
  return Promise.all(anims).catch(() => {}).then(join);
}

// Flyers: what travels from the board to the train. Positioned in page
// coordinates on <body>, so they land right even if the learner scrolls.
function placeFlyer(node, r) {
  Object.assign(node.style, { position: "absolute", left: r.left + "px", top: r.top + "px", width: r.width + "px", height: r.height + "px", margin: 0, zIndex: 45, pointerEvents: "none" });
  document.body.appendChild(node);
  return { node, r };
}
// A copy of a tile, lifted off it where it stands.
function cloneFlyer(t) {
  const clone = t.cloneNode(true);
  clone.classList.add("mu-flying");
  return placeFlyer(clone, pageRect(t));
}

// The flyers head for the waiting slot, then the carriage drops onto the rail,
// its dashed slot fades, and it couples with a bump through the train. Several
// carriages can be in the air at once: the learner never waits. The caller
// counted this carriage into `landing` at the moment of the match.
function coupleCarriage(k, pair, makeFlyers) {
  const done = () => {
    slotsG.children[k].classList.add("is-filled");
    landing--;
    if (matched >= lefts.length && !landing) finishGame();
  };
  const car = carriage(k, pair);
  if (reduceMotion) { done(); return; }
  gsap.set(car.querySelector(".mu-car-inner"), { opacity: 0 });
  // Aim at the waiting slot's on-screen centre (it already includes #muFit's scaling).
  const slot = slotsG.children[k].getBoundingClientRect();
  const target = { x: slot.left + slot.width / 2 + window.scrollX, y: slot.top + slot.height / 2 + window.scrollY };
  const flyers = makeFlyers();
  let arrived = 0;
  flyers.forEach(({ node, r }, j) => {
    gsap.timeline({ onComplete: () => { node.remove(); if (++arrived === flyers.length) dropIn(); } })
      .to(node, { y: -10, scale: 1.05, duration: 0.16, ease: "power2.out" })
      .to(node, { left: (target.x - r.width / 2) + "px", top: (target.y - r.height / 2) + "px", scale: 0.35, opacity: 0.2, duration: 0.6, ease: "power2.in", delay: j * 0.06 });
  });
  function dropIn() {
    const inner = car.querySelector(".mu-car-inner");
    gsap.timeline({ onComplete: done })
      .fromTo(inner, { y: -70, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, ease: "bounce.out" })
      .add(() => { smokePuff(3, true); sparkle(target.x, target.y - 30); })
      .add(() => slotsG.children[k].classList.add("is-filled"))
      .to(trainGroup, { x: 7, duration: 0.09, ease: "power2.out", overwrite: "auto" })
      .to(trainGroup, { x: 0, duration: 0.5, ease: "elastic.out(1, 0.4)" });
  }
}

function sparkle(x, y) {
  for (let k = 0; k < 10; k++) {
    const s = document.createElement("span");
    s.className = "mu-spark";
    Object.assign(s.style, { left: (x - 4) + "px", top: (y - 4) + "px", background: ["#FCD34D", "#FFFFFF", "#86EFAC"][k % 3] });
    document.body.appendChild(s);
    gsap.to(s, { x: (Math.random() - 0.5) * 110, y: (Math.random() - 0.8) * 80, rotation: 225, opacity: 0, duration: 0.8, ease: "power2.out", onComplete: () => s.remove() });
  }
}

function showHint(text) {
  const hint = document.getElementById("tryAgain");
  if (!hint.dataset.text) hint.dataset.text = hint.textContent;
  hint.textContent = text || hint.dataset.text;
  gsap.killTweensOf(hint);
  gsap.fromTo(hint, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.25, onComplete: () => gsap.to(hint, { opacity: 0, delay: 1.1 }) });
}

// ── Finish: the driver waves and the train chugs away ───────────────────
async function finishGame() {
  finished = true;
  updateProgress();
  const scene = document.getElementById("muScene");
  scene.classList.add("is-done");
  if (!reduceMotion) {
    smokePuff(4, true);
    gsap.timeline({ delay: 0.5 })
      .to(trainGroup, { x: -14, duration: 0.35, ease: "power2.out" })
      .add(() => { scene.classList.add("is-moving"); const puffs = setInterval(() => smokePuff(1, true), 260); setTimeout(() => clearInterval(puffs), 2600); })
      .to(trainGroup, { x: 1300, duration: 2.8, ease: "power2.in" });
  }

  await GameKit.finish({}, { after: reduceMotion ? 600 : 3000 });
}

loadPairs();
</script>
</GamePage>
