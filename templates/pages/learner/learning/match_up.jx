 fill="#FFFFFF" opacity="0.85"/></svg>
          <svg class="mu-front" viewBox="0 0 1200 400" preserveAspectRatio="xMidYMax slice" aria-hidden="true"><path d="M-20 400 C-30 360 -6 330 30 336 C40 312 80 310 96 334 C120 330 140 352 134 372 C150 380 150 400 150 400Z" fill="#2F6328"/><path d="M-20 400 C-24 372 -4 352 24 356 C34 338 66 336 80 356 C96 356 110 372 104 400Z" fill="#3F7A33"/><path d="M1220 400 C1230 356 1200 332 1170 342 C1158 320 1120 322 1110 344 C1086 342 1070 364 1078 400Z" fill="#2F6328"/><path d="M1220 400 C1222 374 1204 360 1180 364 C1170 350 1144 350 1136 368 C1120 370 1112 386 1118 400Z" fill="#3F7A33"/><path class="mu-sway" style="--sw:5.6s" d="M120 400 q2 -7 -4 -12 q8 5 9 12 q1 -9 7 -14 q-2 7 1 14Z" fill="#2F6328"/><circle cx="122" cy="384" r="3.2" fill="#FDE68A"/><path class="mu-sway" style="--sw:4.4s" d="M178 400 q2 -12 -4 -19 q8 8 9 19 q1 -13 7 -21 q-2 12 1 21Z" fill="#3F7A33"/><path class="mu-sway" style="--sw:4.5s" d="M238 400 q2 -11 -4 -18 q8 7 9 18 q1 -12 7 -19 q-2 11 1 19Z" fill="#3F7A33"/><circle cx="240" cy="378" r="3.2" fill="#FFFFFF"/><path class="mu-sway" style="--sw:5.5s" d="M276 400 q2 -9 -4 -15 q8 6 9 15 q1 -11 7 -17 q-2 9 1 17Z" fill="#3F7A33"/><path class="mu-sway" style="--sw:4.1s" d="M309 400 q2 -14 -4 -23 q8 9 9 23 q1 -16 7 -26 q-2 14 1 26Z" fill="#3F7A33"/><path class="mu-sway" style="--sw:3.3s" d="M345 400 q2 -12 -4 -20 q8 8 9 20 q1 -14 7 -22 q-2 12 1 22Z" fill="#2F6328"/><path class="mu-sway" style="--sw:3.7s" d="M402 400 q2 -10 -4 -16 q8 7 9 16 q1 -11 7 -18 q-2 10 1 18Z" fill="#2F6328"/><path class="mu-sway" style="--sw:5.3s" d="M449 400 q2 -13 -4 -21 q8 9 9 21 q1 -15 7 -24 q-2 13 1 24Z" fill="#3F7A33"/><path class="mu-sway" style="--sw:3.7s" d="M503 400 q2 -13 -4 -21 q8 8 9 21 q1 -15 7 -23 q-2 13 1 23Z" fill="#2F6328"/><path class="mu-sway" style="--sw:3.8s" d="M530 400 q2 -7 -4 -12 q8 5 9 12 q1 -9 7 -14 q-2 7 1 14Z" fill="#2F6328"/><circle cx="532" cy="384" r="3.2" fill="#FFFFFF"/><path class="mu-sway" style="--sw:5.8s" d="M588 400 q2 -10 -4 -17 q8 7 9 17 q1 -12 7 -19 q-2 10 1 19Z" fill="#2F6328"/><path class="mu-sway" style="--sw:3.7s" d="M626 400 q2 -9 -4 -15 q8 6 9 15 q1 -10 7 -16 q-2 9 1 16Z" fill="#3F7A33"/><path class="mu-sway" style="--sw:4.8s" d="M669 400 q2 -14 -4 -24 q8 10 9 24 q1 -17 7 -26 q-2 14 1 26Z" fill="#3F7A33"/><path class="mu-sway" style="--sw:3.3s" d="M717 400 q2 -13 -4 -22 q8 9 9 22 q1 -15 7 -24 q-2 13 1 24Z" fill="#3F7A33"/><path class="mu-sway" style="--sw:4.4s" d="M770 400 q2 -13 -4 -21 q8 8 9 21 q1 -15 7 -23 q-2 13 1 23Z" fill="#3F7A33"/><path class="mu-sway" style="--sw:5.8s" d="M817 400 q2 -8 -4 -13 q8 5 9 13 q1 -9 7 -14 q-2 8 1 14Z" fill="#2F6328"/><path class="mu-sway" style="--sw:3.5s" d="M869 400 q2 -8 -4 -13 q8 5 9 13 q1 -9 7 -14 q-2 8 1 14Z" fill="#3F7A33"/><circle cx="871" cy="383" r="3.2" fill="#FFFFFF"/><path class="mu-sway" style="--sw:3.4s" d="M925 400 q2 -13 -4 -22 q8 9 9 22 q1 -15 7 -24 q-2 13 1 24Z" fill="#2F6328"/><path class="mu-sway" style="--sw:3.4s" d="M963 400 q2 -11 -4 -19 q8 7 9 19 q1 -13 7 -20 q-2 11 1 20Z" fill="#3F7A33"/><path class="mu-sway" style="--sw:5.2s" d="M1014 400 q2 -8 -4 -13 q8 5 9 13 q1 -9 7 -15 q-2 8 1 15Z" fill="#3F7A33"/><path class="mu-sway" style="--sw:3.6s" d="M1070 400 q2 -13 -4 -22 q8 9 9 22 q1 -15 7 -24 q-2 13 1 24Z" fill="#2F6328"/><circle cx="1072" cy="374" r="3.2" fill="#FFFFFF"/></svg>
