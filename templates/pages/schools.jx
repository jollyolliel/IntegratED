{#- The public school directory: a hero, then the top three and the searchable A–Z grid, a region
    that swaps in place when the pager is used (its styles live here, so they survive the swap). -#}
{#import "@components/shell/page.jx" as Page #}
{#import "@page_components/public/schools_results.jx" as SchoolsResults #}
{#import "@components/base/icon.jx" as Icon #}
{#def school_stats, page, page_count, top_schools=[], school_count=0, q="" #}
{%- set head %}
  <style>
    .schools-hero { padding-block: clamp(48px, 7vw, 104px); background: var(--color-primary-tint); border-bottom: var(--clay-border-width) solid var(--color-card-sky-border); overflow: hidden; }
    .schools-hero-grid { max-width: 1180px; margin-inline: auto; padding-inline: clamp(20px, 6vw, 56px); display: grid; gap: 48px; align-items: center; }
    @media (min-width: 1024px) { .schools-hero-grid { grid-template-columns: 1.1fr 1fr; } }
    .schools-hero-title { color: var(--color-ink-heading); margin-bottom: 22px; }
    .schools-hero-lead { color: var(--color-ink-body); max-width: 34em; }
    .schools-hero-photo { position: relative; max-width: 34rem; margin-inline: auto; width: 100%; rotate: 2.5deg; }
    .schools-hero-photo figure { margin: 0; overflow: hidden; aspect-ratio: 4 / 3; border-radius: 28px; border: 4px solid var(--color-sky-300); box-shadow: 10px 10px 0 var(--color-sky-200); }
    .schools-hero-photo img { width: 100%; height: 100%; object-fit: cover; }
    .schools-hero-pin { position: absolute; bottom: -18px; inset-inline-start: 24px; display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px 8px 12px; border-radius: 999px; background: var(--color-surface); border: var(--clay-border-width) solid var(--color-card-rose-border); box-shadow: 3px 3px 0 var(--color-card-rose-shadow); font-weight: 800; color: var(--color-ink-heading); rotate: -3.75deg; }
    .schools-hero-pin svg { color: var(--color-rose-500); }

    .school-dir { padding-block: clamp(56px, 7vw, 104px); background: var(--color-surface); }
    .school-dir-inner { max-width: 1180px; margin-inline: auto; padding-inline: clamp(16px, 5vw, 40px); }
    .school-dir-h2 { font-size: clamp(1.9rem, 3vw, 2.75rem); line-height: 1.1; color: var(--color-ink-heading); }
    .school-dir-feature { display: grid; gap: 20px; margin: 24px 0 clamp(56px, 7vw, 88px); }
    @media (min-width: 900px) { .school-dir-feature { grid-template-columns: 1.6fr 1fr; grid-template-rows: 1fr 1fr; } .school-dir-feature > :first-child { grid-row: 1 / 3; } }
    .school-dir-lead, .school-dir-side { display: flex; flex-direction: column; gap: 12px; height: 100%; }
    .school-dir-lead .school-dir-photo { flex: 1; min-height: 240px; aspect-ratio: auto; }
    .school-dir-side { flex-direction: row; align-items: center; gap: 16px; }
    .school-dir-side .school-dir-photo { flex: none; width: 42%; aspect-ratio: 4 / 3; }
    .school-dir-photo { position: relative; display: block; overflow: hidden; aspect-ratio: 16 / 10; border-radius: 14px; background: var(--color-primary-tint); }
    .school-dir-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .school-dir-mark { position: absolute; inset: 0; display: grid; place-items: center; font-family: 'Baloo 2', system-ui, sans-serif; font-weight: 800; font-size: 2.6rem; color: var(--color-primary-dark); }
    .school-dir-rank { position: absolute; top: 10px; inset-inline-start: 10px; }
    .school-dir-name { display: block; font-family: 'Baloo 2', system-ui, sans-serif; font-weight: 800; font-size: 1.2rem; line-height: 1.15; color: var(--color-ink-heading); }
    .school-dir-lead .school-dir-name { font-size: clamp(1.5rem, 2.4vw, 2rem); }
    .school-dir-mission { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 4px; font-size: 0.95rem; line-height: 1.45; color: var(--color-ink-body); }
    .school-dir-facts { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 8px; font-size: 0.875rem; font-weight: 700; color: var(--color-ink-muted); }
    .school-dir-facts strong { font-family: 'Baloo 2', system-ui, sans-serif; font-size: 1.1rem; font-variant-numeric: tabular-nums; margin-inline-end: 4px; }
    .school-dir-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px 24px; margin-bottom: 8px; scroll-margin-top: 96px; }
    .school-dir-search { display: flex; gap: 10px; width: min(100%, 420px); }
    .school-dir-field { flex: 1; min-width: 0; }
    .school-dir-count { margin-bottom: 24px; font-weight: 600; color: var(--color-ink-muted); }
    .school-dir-count a { color: var(--color-primary-dark); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; margin-inline-start: 8px; }
    .school-dir-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr)); }
    .school-dir-card { display: flex; flex-direction: column; gap: 12px; height: 100%; }
    .school-dir-empty { display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 48px 16px; text-align: center; border-radius: 20px; border: var(--clay-border-width-thin) dashed var(--color-primary-light); background: var(--color-primary-tint); font-weight: 600; color: var(--color-ink-body); }
    .school-dir-empty img { width: 80px; }
    @media (max-width: 559px) { .school-dir-side { flex-direction: column; align-items: stretch; } .school-dir-side .school-dir-photo { width: 100%; } .school-dir-search { width: 100%; } }
    /* Rank chips on the directory's top schools. */
    .rank-badge { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 10px; font-weight: 800; font-size: 0.9rem; }
    .rank-1 { background: var(--color-amber-200); color: var(--color-amber-800); border: 2px solid var(--color-amber-300); box-shadow: 2px 2px 0 var(--color-amber-300); }
    .rank-2 { background: var(--color-line); color: var(--color-ink-body); border: 2px solid var(--color-gray-300); box-shadow: 2px 2px 0 var(--color-gray-300); }
    .rank-3 { background: var(--color-rose-200); color: var(--color-rose-800); border: 2px solid var(--color-rose-300); box-shadow: 2px 2px 0 var(--color-rose-300); }
    .rank-n { background: var(--color-sky-50); color: var(--color-sky-700); border: 2px solid var(--color-sky-200); box-shadow: 2px 2px 0 var(--color-sky-200); }
  </style>
{%- endset %}
<Page head={{ head }} title={{ t('schools.heading') ~ " - IntegratED" }} styles="public">
  <main class="flex-1">
    <section class="schools-hero">
      <div class="schools-hero-grid">
        <div>
          <h1 class="schools-hero-title pub-display display-font font-extrabold">{{ t('schools.heading') }}</h1>
          <p class="schools-hero-lead pub-lead">{{ t('schools.description') }}</p>
        </div>
        <div class="schools-hero-photo">
          <figure><img src="{{ url_for('static', filename='img/acs-athens.jpg') }}" alt="{{ t('schools.acs_athens') }}" decoding="async" /></figure>
          <span class="schools-hero-pin"><Icon name="map-pin" size="5" />{{ t('schools.hero_location') }}</span>
        </div>
      </div>
    </section>

    <SchoolsResults school_stats={{ school_stats }} page={{ page }} page_count={{ page_count }}
                    top_schools={{ top_schools }} school_count={{ school_count }} q={{ q }} />
  </main>
</Page>
