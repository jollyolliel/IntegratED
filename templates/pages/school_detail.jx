{#- One school's public page, opened from the /schools directory: its photo and logo (initials
    when it has none), its mission set large, its own impact counted from the live tables, and one
    way to support it. `impact` is {learners, volunteers, pairs, hours, raised}. -#}
{#import "@page_components/public/school_photo.jx" as SchoolPhoto #}
{#import "@components/shell/page.jx" as Page #}
{#import "@components/base/icon.jx" as Icon #}
{#import "@components/base/button.jx" as Button #}
{#import "@components/base/card.jx" as Card #}
{#def school, impact #}
{%- set head %}
  <style>
    .sd-hero { padding-block: clamp(28px, 4vw, 48px) clamp(56px, 7vw, 104px); background: var(--color-primary-tint); border-bottom: var(--clay-border-width) solid var(--color-card-sky-border); overflow: hidden; }
    .sd-wrap { max-width: 1180px; margin-inline: auto; padding-inline: clamp(16px, 6vw, 56px); }
    .sd-hero-grid { display: grid; gap: clamp(36px, 5vw, 56px); align-items: center; margin-top: clamp(24px, 4vw, 48px); }
    @media (min-width: 1024px) { .sd-hero-grid.has-photo { grid-template-columns: 1fr 1.1fr; } }
    .school-mark { display: grid; place-items: center; width: clamp(72px, 9vw, 96px); aspect-ratio: 1; border-radius: 24px; background: var(--color-surface); border: var(--clay-border-width) solid var(--color-card-sky-border); box-shadow: 4px 4px 0 var(--color-card-sky-shadow); font-family: 'Baloo 2', system-ui, sans-serif; font-weight: 800; font-size: clamp(1.75rem, 3vw, 2.4rem); line-height: 1; color: var(--color-primary-dark); overflow: hidden; }
    .school-mark img { width: 78%; height: 78%; object-fit: contain; }
    .sd-name { font-size: clamp(2.4rem, 5vw, 4.5rem); line-height: 1.1; letter-spacing: -0.02em; text-wrap: balance; color: var(--color-ink-heading); margin-top: 22px; }
    .sd-place { display: inline-flex; align-items: center; gap: 8px; margin-top: 18px; padding: 8px 16px 8px 12px; border-radius: 999px; background: var(--color-surface); border: var(--clay-border-width-thin) solid var(--color-card-rose-border); font-weight: 800; color: var(--color-ink-heading); }
    .sd-place svg { color: var(--color-alert); }
    .sd-photo { margin: 0; overflow: hidden; aspect-ratio: 4 / 3; border-radius: 28px; border: 4px solid var(--color-primary-light); box-shadow: 10px 10px 0 var(--color-primary-soft); rotate: 1.5deg; }
    .sd-photo img { width: 100%; height: 100%; object-fit: cover; }
    .sd-section { padding-block: clamp(56px, 7vw, 104px); }
    .sd-h2 { font-size: clamp(1.5rem, 2.2vw, 2rem); line-height: 1.15; color: var(--color-ink-heading); margin-bottom: 20px; }
    .sd-statement { font-family: 'Baloo 2', system-ui, sans-serif; font-weight: 700; font-size: clamp(1.6rem, 3.2vw, 2.75rem); line-height: 1.35; text-wrap: pretty; color: var(--color-primary-dark); max-width: 30ch; padding-inline-start: clamp(18px, 2.5vw, 28px); border-inline-start: 6px solid var(--color-primary-light); }
    .sd-impact { background: var(--color-surface); border-block: var(--clay-border-width) solid var(--color-card-sky-border); }
    .sd-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr)); gap: 20px; }
    .sd-stat { display: flex; flex-direction: column; gap: 6px; }
    .sd-stat-icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 14px; margin-bottom: 6px; }
    .sd-num { font-family: 'Baloo 2', system-ui, sans-serif; font-weight: 800; font-size: clamp(2.25rem, 3.5vw, 3rem); line-height: 1; font-variant-numeric: tabular-nums; color: var(--color-ink-heading); }
    .sd-label { font-weight: 700; color: var(--color-ink-body); }
    .sd-empty { display: flex; align-items: center; gap: 20px; padding: 28px; border-radius: 20px; border: var(--clay-border-width-thin) dashed var(--color-primary-light); background: var(--color-primary-tint); }
    .sd-empty img { flex: none; width: 72px; }
    .sd-empty strong { display: block; font-family: 'Baloo 2', system-ui, sans-serif; font-size: 1.25rem; color: var(--color-ink-heading); }
    .sd-cta { text-align: center; }
    .sd-cta p { max-width: 40ch; margin: 0 auto 28px; font-size: 1.125rem; line-height: 1.6; color: var(--color-ink-body); }
    @media (max-width: 559px) { .sd-empty { flex-direction: column; text-align: center; } .sd-photo { rotate: none; } }
  </style>
{%- endset %}
<Page head={{ head }} title={{ school.name ~ " - IntegratED" }}>
  <main class="flex-1">
    <section class="sd-hero">
      <div class="sd-wrap">
        <Button variant="soft" href={{ url_for('base.schools') }} icon="arrow-left">{{ t('school_detail.all_schools') }}</Button>
        <div class="sd-hero-grid{% if school.image_path %} has-photo{% endif %}">
          <div>
            <span class="school-mark">
              <SchoolPhoto school={{ school }} variant="logo" />
            </span>
            <h1 class="sd-name display-font font-extrabold">{{ school.name }}</h1>
            {%- if school.location %}
            <p class="sd-place"><Icon name="map-pin" size="5" />{{ school.location }}</p>
            {%- endif %}
          </div>
          {%- if school.image_path %}
          <figure class="sd-photo"><img src="{{ url_for('static', filename=school.image_path) }}" alt="{{ school.name }}" decoding="async" /></figure>
          {%- endif %}
        </div>
      </div>
    </section>

    <section class="sd-section">
      <div class="sd-wrap">
        <h2 class="sd-h2">{{ t('school_detail.mission_heading') }}</h2>
        <p class="sd-statement">{{ school.mission_statement or t('schools.default_mission') }}</p>
      </div>
    </section>

    <section class="sd-section sd-impact">
      <div class="sd-wrap">
        <h2 class="sd-h2">{{ t('school_detail.impact_heading') }}</h2>
        {%- if impact.learners or impact.volunteers or impact.raised %}
        {#- Tones follow meaning: matched pairs are green, hours are amber, the rest sky. -#}
        {%- set tiles = [
          ('sky', 'bg-sky-50 text-primary', 'academic-cap', 'learners', impact.learners, t('school_detail.learners')),
          ('sky', 'bg-sky-50 text-primary', 'hand-raised', 'volunteers', impact.volunteers, t('school_detail.volunteers')),
          ('green', 'bg-green-50 text-accent', 'user-group', 'pairs', impact.pairs, t('school_detail.pairs')),
          ('amber', 'bg-amber-50 text-amber-600', 'clock', 'hours', '%g'|format(impact.hours), t('school_detail.hours')),
          ('sky', 'bg-sky-50 text-primary', 'heart', 'raised', '$%.0f'|format(impact.raised), t('school_detail.raised')),
        ] %}
        <div class="sd-stats">
          {%- for tone, icon_classes, icon_name, key, value, label in tiles %}
          <Card tone={{ tone }} class="sd-stat">
            <span class="sd-stat-icon {{ icon_classes }}"><Icon name={{ icon_name }} size="6" /></span>
            <span class="sd-num" data-stat="{{ key }}">{{ value }}</span>
            <span class="sd-label">{{ label }}</span>
          </Card>
          {%- endfor %}
        </div>
        {%- else %}
        <div class="sd-empty" data-impact-empty>
          <img src="{{ url_for('static', filename='svg/school.svg') }}" alt="" />
          <p><strong>{{ t('school_detail.empty_title') }}</strong>{{ t('school_detail.empty_body') }}</p>
        </div>
        {%- endif %}
      </div>
    </section>

    <section class="sd-section sd-cta">
      <div class="sd-wrap">
        <h2 class="sd-h2">{{ t('school_detail.cta_heading', name=school.name) }}</h2>
        <p>{{ t('school_detail.cta_body') }}</p>
        <Button variant="accent" size="lg" href={{ url_for('base.donations', school=school.id) }} icon="heart"
                data-cta="donate" data-cta-location="school_detail">{{ t('school_detail.cta_donate') }}</Button>
      </div>
    </section>
  </main>
</Page>
