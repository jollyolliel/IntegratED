{#- Create a school and, optionally, its first School Admin login. -#}
{#import "@components/shell/page.jx" as Page #}
{#import "@components/back_link.jx" as BackLink #}
{#import "@components/section_badge.jx" as SectionBadge #}
{#import "@components/base/card.jx" as Card #}
{#import "@components/base/field.jx" as Field #}
{#import "@components/base/input.jx" as Input #}
{#import "@components/base/textarea.jx" as Textarea #}
{#import "@components/base/button.jx" as Button #}
{#import "@components/shell/main.jx" as Main #}
<Page title="New School — Admin">
  <Main>
    <div class="mb-6">
      <BackLink href={{ url_for('administrator.schools') }} label="Schools" />
      <h1 class="display-font text-4xl font-extrabold text-sky-950 mt-1">Create New School</h1>
    </div>

    <form action="{{ url_for('administrator.create_school') }}" method="POST" class="max-w-2xl space-y-6">
      <Card>
        <div class="flex items-center gap-2 mb-5">
          <SectionBadge>Details</SectionBadge>
          <h2 class="display-font font-bold text-sky-900">School Details</h2>
        </div>

        <div class="space-y-5">
          <Field label="School Name" for_id="school-name" required>
            <Input name="name" id="school-name" required placeholder={{ t('administrator.school_name_placeholder') }} />
          </Field>

          <Field label="Mission Statement" for_id="school-mission">
            <Textarea name="mission_statement" id="school-mission" rows="3" placeholder={{ t('administrator.mission_placeholder') }}></Textarea>
          </Field>

          <div class="grid grid-cols-2 gap-4">
            <Field label="Volunteer Domain" for_id="school-volunteer-domain">
              <Input name="volunteer_domain" id="school-volunteer-domain" class="font-mono"
                placeholder={{ t('administrator.student_domain_placeholder') }} />
              <p class="text-xs text-ink-faint mt-1.5">Students sign in as Volunteers</p>
            </Field>
            <Field label="Teacher Domain" for_id="school-teacher-domain">
              <Input name="teacher_domain" id="school-teacher-domain" class="font-mono"
                placeholder={{ t('administrator.school_domain_placeholder') }} />
              <p class="text-xs text-ink-faint mt-1.5">Staff sign in as Teachers</p>
            </Field>
          </div>
        </div>
      </Card>

      <Card tone="amber">
        <div class="flex items-center gap-2 mb-1">
          <SectionBadge tone="amber">Optional</SectionBadge>
          <h2 class="display-font font-bold text-amber-900">School Admin Account</h2>
        </div>
        <p class="text-xs text-amber-700 mb-5">Create a School Admin login for this school.</p>

        <div class="space-y-5">
          <Field label="Admin Name" for_id="school-admin-name">
            <Input name="admin_name" id="school-admin-name" placeholder={{ t('administrator.admin_name_placeholder') }} />
          </Field>

          <div class="grid grid-cols-2 gap-4">
            <Field label="Username" for_id="school-admin-username">
              <Input name="admin_username" id="school-admin-username" class="font-mono" data-no-spaces
                placeholder={{ t('administrator.admin_username_placeholder') }} />
            </Field>
            <Field label="Password" for_id="school-admin-password">
              <Input type="password" name="admin_password" id="school-admin-password" data-no-spaces
                placeholder={{ t('administrator.admin_password_placeholder') }} />
            </Field>
          </div>
        </div>
      </Card>

      <div class="flex gap-3">
        <Button type="submit" icon="plus">Create School</Button>
        <Button variant="gray" href={{ url_for('administrator.schools') }}>Cancel</Button>
      </div>
    </form>
  </Main>
</Page>
