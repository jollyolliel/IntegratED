{#- The "what's new" popup, rendered by <Header> when a dashboard route passed a pending
    announcement (helpers/announcements.py). One component, three layouts. Content is authored
    English in data/announcements.json and is NOT run through t() — only the chrome is. See
    docs/ui-design/page-behaviour.md. -#}
{#import "@components/section_badge.jx" as SectionBadge #}
{#import "@components/base/button.jx" as Button #}
{#def announcement #}
{%- set content = announcement.content or {} -%}
{%- set layout = content.get("layout", "text_only") -%}
{%- set body %}
  {%- if layout == "text_only" %}
    <div class="announce-icon">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
      </svg>
    </div>
  {%- endif %}
  {%- if content.get("badge") %}
    <SectionBadge>{{ content["badge"] }}</SectionBadge>
  {%- endif %}
  <h2 id="feature-announcement-title" class="display-font announce-title">{{ content.get("title", "") }}</h2>
  <p class="announce-text">{{ content.get("body", "") }}</p>
  {%- if content.get("cta_label") or content.get("secondary_label") %}
    <div class="announce-actions">
      {%- if content.get("cta_label") %}
        <Button href={{ content.get("cta_url", "#") }} data-announce-cta>{{ content["cta_label"] }}</Button>
      {%- endif %}
      {%- if content.get("secondary_label") %}
        {#- Dismiss-only: closes and marks seen, never navigates. #}
        <Button variant="gray" data-announce-dismiss>{{ content["secondary_label"] }}</Button>
      {%- endif %}
    </div>
  {%- endif %}
{%- endset -%}

<div id="feature-announcement-overlay"
     class="announce-overlay"
     data-announcement-id="{{ announcement.id }}"
     role="dialog" aria-modal="true" aria-labelledby="feature-announcement-title">
  <div class="announce-card {{ 'announce-card-wide' if layout == 'text_image_side' else 'announce-card-narrow' }}">
    <button type="button" class="announce-close" data-announce-dismiss
            aria-label="{{ t('common.close') }}">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    {%- if layout == "text_image_side" %}
      <div class="announce-split">
        <div class="announce-body">{{ body }}</div>
        <div class="announce-media">
          {%- if content.get("image_url") %}
            <img src="{{ content['image_url'] }}" alt="" />
          {%- endif %}
        </div>
      </div>
    {%- else %}
      {%- if layout == "text_image_top" and content.get("image_url") %}
        <div class="announce-media announce-media-top">
          <img src="{{ content['image_url'] }}" alt="" />
        </div>
      {%- endif %}
      <div class="announce-body">{{ body }}</div>
    {%- endif %}
  </div>
</div>

<script>
  (function () {
    const overlay = document.getElementById("feature-announcement-overlay");
    if (!overlay) return;
    const dismissUrl = "/api/announcements/" + overlay.dataset.announcementId + "/dismiss";
    let dismissed = false;

    // Marks the announcement seen server-side. Called on close, backdrop,
    // Escape, the secondary button and the CTA — never on mere render, so the
    // popup reappears on the next dashboard load until the user acts.
    function dismiss() {
      overlay.classList.add("hidden");
      if (dismissed) return Promise.resolve();
      dismissed = true;
      return fetch(dismissUrl, {
        method: "POST",
        headers: { "X-Requested-With": "XMLHttpRequest" },
        keepalive: true,
      }).catch(() => {});
    }

    overlay.querySelectorAll("[data-announce-dismiss]").forEach((el) => {
      el.addEventListener("click", dismiss);
    });

    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) dismiss();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !overlay.classList.contains("hidden")) dismiss();
    });

    const cta = overlay.querySelector("[data-announce-cta]");
    if (cta) {
      cta.addEventListener("click", (e) => {
        e.preventDefault();
        const href = cta.getAttribute("href");
        // Navigate once the mark is stored, so a fast click can't race the POST.
        dismiss().then(() => { window.location.href = href; });
      });
    }
  })();
</script>
