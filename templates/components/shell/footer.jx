{#- The site footer: logo, copyright + deployed version, and the about / news / donate / legal links. -#}
<footer class="bg-white border-t-2 border-primary-soft mt-auto">
  <div class="container mx-auto px-4 py-6 flex flex-col sm:flex-row items-center justify-between gap-3">
    <div class="flex items-center gap-2">
      <div class="w-7 h-7 bg-primary rounded-lg border-[1.5px] border-primary-dark shadow-[1px_1px_0_var(--color-primary-dark)] flex items-center justify-center">
        <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
      </div>
      <span class="display-font font-bold text-sky-700 text-[0.95rem]">IntegratED</span>
    </div>
    <p class="text-ink-faint text-[0.8rem]">
      © 2025 IntegratED · Youth-to-Youth Learning Platform
      {% if app_version != "dev" %}
      {% if github_repo_url %}
      · <a href="{{ github_repo_url }}/commit/{{ app_version_full }}" target="_blank" rel="noopener" class="text-ink-faint no-underline hover:text-primary transition-colors">v{{ app_version }}</a>
      {% else %}
      · v{{ app_version }}
      {% endif %}
      {% endif %}
    </p>
    <div class="flex items-center gap-4">
      <a href="{{ url_for('base.about') }}" class="text-ink-muted text-[0.85rem] no-underline hover:text-primary transition-colors">{{ t('footer.about') }}</a>
      <a href="{{ url_for('base.articles_list') }}" class="text-ink-muted text-[0.85rem] no-underline hover:text-primary transition-colors">{{ t('footer.news') }}</a>
      <a href="{{ url_for('base.donations') }}" class="text-ink-muted text-[0.85rem] no-underline hover:text-primary transition-colors">{{ t('footer.donate') }}</a>
      <a href="{{ url_for('base.terms') }}" class="text-ink-muted text-[0.85rem] no-underline hover:text-primary transition-colors">{{ t('footer.terms') }}</a>
      <a href="{{ url_for('base.privacy') }}" class="text-ink-muted text-[0.85rem] no-underline hover:text-primary transition-colors">{{ t('footer.privacy') }}</a>
    </div>
  </div>
</footer>
