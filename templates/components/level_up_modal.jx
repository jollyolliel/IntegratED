{#- The level-up celebration on the game pages: an amber Card whose starry purple stage holds the
    level-badge.svg medal with the new level set on its face (it ticks up from the old one), then
    the level's name, the wardrobe items the level unlocked and the dismiss button. Opens over the
    completion overlay when `window.showLevelUpModal(newLevel, levelName, newItems)` is called —
    `newItems` is the completion's `new_items_unlocked` ([{id, type, label}], optional);
    `window.dismissLevelUp()` (or Escape) closes it. Confetti comes
    from `CompletionOverlay.confetti`; the motion needs GSAP, which <GamePage> loads. -#}
{#import "@components/base/card.jx" as Card #}
{#import "@components/base/badge.jx" as Badge #}
{#import "@components/base/button.jx" as Button #}
{#import "@components/icon_box.jx" as IconBox #}
{#import "@components/section_badge.jx" as SectionBadge #}
{%- set art = url_for('static', filename='svg/') %}
{%- set sparkle_d = "M12 0C12 7 17 12 24 12C17 12 12 17 12 24C12 17 7 12 0 12C7 12 12 7 12 0Z" %}
<div id="levelUpModal" class="hidden fixed inset-0 z-[60] flex p-4 overflow-y-auto bg-primary/[0.3] backdrop-blur-[10px]">
  <Card tone="amber" id="levelUpContent" class="!p-0 relative overflow-hidden m-auto w-full max-w-sm text-center opacity-0" role="dialog" aria-modal="true" aria-labelledby="levelUpTitle">
    <div class="level-up-stage" aria-hidden="true">
      <div class="level-up-stars"></div>
      <div class="level-up-rays"></div>
      <svg class="level-up-sparkle level-up-sparkle-a" viewBox="0 0 24 24"><path d="{{ sparkle_d }}" /></svg>
      <svg class="level-up-sparkle level-up-sparkle-b" viewBox="0 0 24 24"><path d="{{ sparkle_d }}" /></svg>
      <svg class="level-up-sparkle level-up-sparkle-c" viewBox="0 0 24 24"><path d="{{ sparkle_d }}" /></svg>
      <div class="level-up-badge-bob">
        <div class="level-up-badge" id="levelUpBadge">
          <img src="{{ art }}level-badge.svg" alt="" width="200" height="200" />
          <span id="levelUpNumber" class="display-font">1</span>
        </div>
      </div>
      <svg class="level-up-wave" viewBox="0 0 400 28" preserveAspectRatio="none">
        <path d="M0 14 C40 0 60 0 100 12 C140 24 160 24 200 12 C240 0 260 0 300 12 C340 24 360 24 400 10 L400 28 L0 28 Z" />
      </svg>
    </div>

    <div class="px-6 pb-6 pt-1 space-y-4">
      <div class="level-up-reveal">
        <SectionBadge tone="amber">{{ t("gamification.achievement_unlocked") }}</SectionBadge>
        <h2 id="levelUpTitle" class="display-font level-up-title font-extrabold text-ink-heading">{{ t("learner.level_up.title") }}</h2>
        <p id="levelUpLevelText" class="text-base font-bold text-amber-800 mt-1"></p>
      </div>
      <div id="levelUpItems" class="level-up-reveal hidden flex flex-wrap justify-center gap-3"></div>
      <div class="level-up-reveal">
        <Button size="lg" id="levelUpDismiss" class="w-full" onclick="window.dismissLevelUp()">{{ t("learner.level_up.dismiss") }}</Button>
      </div>
    </div>
  </Card>
  <div id="levelUpConfetti" class="fixed inset-0 pointer-events-none overflow-hidden z-[1]" aria-hidden="true"></div>

  {#- One card per unlocked wardrobe item, cloned by showLevelUpModal. #}
  <template id="levelUpItemTemplate">
    <Card tone="amber" class="level-up-item !p-3 w-[calc(50%-0.375rem)] flex flex-col items-center gap-1.5">
      <IconBox icon="gift" tone="amber" />
      <span class="text-sm font-extrabold leading-tight text-ink-heading" data-item-label></span>
      <Badge tone="amber" class="text-[10px] uppercase tracking-wider px-2 py-0.5">{{ t("components.level_up.new_item") }}</Badge>
    </Card>
  </template>
</div>

<style>
  /* ── The stage: a starry purple sky, slow gold rays, the medal ── */
  .level-up-stage {
    position: relative; height: 200px; overflow: hidden;
    background: radial-gradient(circle at 50% 60%, var(--color-purple-400) 0%, var(--color-purple-600) 48%, var(--color-purple-900) 100%);
  }
  /* Two dot grids drifting upward, so the stars stream past as the level climbs. */
  .level-up-stars {
    position: absolute; inset: 0;
    background-image:
      radial-gradient(rgb(var(--color-surface-rgb) / 0.85) 1.2px, transparent 1.8px),
      radial-gradient(rgb(var(--color-surface-rgb) / 0.45) 1px, transparent 1.6px);
    background-size: 46px 46px, 29px 29px;
    background-position: 0 0, 13px 19px;
    animation: level-up-stream 24s linear infinite;
  }
  @keyframes level-up-stream { to { background-position: 0 -460px, 13px -271px; } }
  .level-up-rays {
    position: absolute; left: 50%; top: 58%; width: 640px; height: 640px; margin: -320px 0 0 -320px;
    background: repeating-conic-gradient(rgb(var(--color-gold-rgb) / 0.22) 0deg 9deg, transparent 9deg 22.5deg);
    -webkit-mask-image: radial-gradient(circle, black 18%, transparent 58%);
    mask-image: radial-gradient(circle, black 18%, transparent 58%);
    animation: level-up-spin 40s linear infinite reverse;
  }
  @keyframes level-up-spin { to { transform: rotate(1turn); } }
  .level-up-sparkle { position: absolute; fill: currentColor; animation: level-up-twinkle 2.4s ease-in-out infinite; }
  .level-up-sparkle-a { width: 22px; top: 22px; inset-inline-start: 18%; color: var(--color-amber-300); }
  .level-up-sparkle-b { width: 15px; top: 64px; inset-inline-end: 17%; color: var(--color-surface); animation-delay: -0.8s; }
  .level-up-sparkle-c { width: 18px; top: 128px; inset-inline-start: 13%; color: var(--color-sky-300); animation-delay: -1.6s; }
  @keyframes level-up-twinkle {
    0%, 100% { transform: scale(1) rotate(0deg); opacity: 1; }
    50% { transform: scale(0.5) rotate(30deg); opacity: 0.55; }
  }
  /* The wrapper bobs (CSS) while GSAP owns the badge's own entrance transform. */
  .level-up-badge-bob { position: absolute; z-index: 2; left: 50%; bottom: 4px; width: 172px; margin-left: -86px; }
  .level-up-badge-bob.is-bobbing { animation: level-up-bob 3.4s ease-in-out infinite; }
  @keyframes level-up-bob {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-8px) rotate(2deg); }
  }
  .level-up-badge { position: relative; }
  .level-up-badge img { display: block; width: 100%; height: auto; }
  /* Sits exactly on the medal's white face: a 38-wide circle centred at (100, 90) of 200. */
  #levelUpNumber {
    position: absolute; left: 31%; top: 26%; width: 38%; height: 38%;
    display: flex; align-items: center; justify-content: center;
    font-size: 52px; font-weight: 800; line-height: 1; color: var(--color-ink-heading);
  }
  .level-up-wave { position: absolute; z-index: 1; left: 0; bottom: -1px; width: 100%; height: 28px; fill: var(--color-surface); }
  .level-up-title { font-size: clamp(2.2rem, 9vw, 2.75rem); line-height: 1.05; }

  @media (prefers-reduced-motion: reduce) {
    .level-up-stars, .level-up-rays, .level-up-sparkle, .level-up-badge-bob.is-bobbing { animation: none; }
  }
</style>

<script>
  (function () {
    const LEVEL_LINE = {{ t("components.level_up.level_line") | tojson }};
    let timeline = null;
    let returnFocus = null;
    const $ = (id) => document.getElementById(id);

    function renderItems(items) {
      const box = $("levelUpItems");
      box.innerHTML = "";
      box.classList.toggle("hidden", items.length === 0);
      items.forEach((item) => {
        const card = $("levelUpItemTemplate").content.firstElementChild.cloneNode(true);
        card.querySelector("[data-item-label]").textContent = item.label;
        box.appendChild(card);
      });
    }

    function onKey(e) {
      if (e.key === "Escape") window.dismissLevelUp();
    }

    window.showLevelUpModal = function (newLevel, levelNameStr, newItems) {
      const modal = $("levelUpModal");
      if (!modal) return;
      const items = newItems || [];
      const card = $("levelUpContent");
      const badge = $("levelUpBadge");
      const bob = card.querySelector(".level-up-badge-bob");
      const number = $("levelUpNumber");
      const line = $("levelUpLevelText");
      line.textContent = levelNameStr ? LEVEL_LINE.replace("{level}", newLevel).replace("{name}", levelNameStr) : "";
      line.classList.toggle("hidden", !levelNameStr);
      renderItems(items);

      returnFocus = document.activeElement;
      modal.classList.remove("hidden");
      modal.scrollTop = 0;
      document.addEventListener("keydown", onKey);
      const focusDismiss = () => $("levelUpDismiss").focus({ preventScroll: true });

      const reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduceMotion || typeof gsap === "undefined") {
        number.textContent = newLevel;
        card.style.opacity = 1;
        focusDismiss();
        return;
      }

      if (timeline) timeline.kill();
      number.textContent = Math.max(1, newLevel - 1);
      const burst = () => window.CompletionOverlay && window.CompletionOverlay.confetti(badge, { count: 64, layer: $("levelUpConfetti") });
      timeline = gsap.timeline()
        .fromTo(modal, { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "power1.out" }, 0)
        .fromTo(card, { opacity: 0, y: 48, scale: 0.9 }, { opacity: 1, y: 0, scale: 1, duration: 0.55, ease: "back.out(1.6)" }, 0.05)
        .fromTo(badge, { scale: 0, rotation: -35, y: 40 }, {
          scale: 1, rotation: 0, y: 0, duration: 1, ease: "elastic.out(1, 0.55)",
          onComplete: () => bob.classList.add("is-bobbing"),
        }, 0.3)
        .fromTo(card.querySelectorAll(".level-up-reveal"), { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out", stagger: 0.12 }, 0.5)
        .fromTo(card.querySelectorAll(".level-up-item"), { opacity: 0, scale: 0.4 }, { opacity: 1, scale: 1, duration: 0.5, ease: "back.out(2.2)", stagger: 0.12 }, 0.75)
        // the old level shrinks away and the new one punches in, with the burst
        .to(number, { scale: 0, duration: 0.18, ease: "power2.in", onComplete: () => { number.textContent = newLevel; } }, 1.0)
        .fromTo(number, { scale: 0 }, { scale: 1, duration: 0.6, ease: "back.out(3)" }, 1.18)
        .fromTo(badge, { scale: 1 }, { scale: 1.12, duration: 0.14, yoyo: true, repeat: 1, ease: "power1.out" }, 1.18)
        .call(burst, null, 1.2)
        .call(focusDismiss, null, 0.9);
    };

    window.dismissLevelUp = function () {
      const modal = $("levelUpModal");
      if (!modal) return;
      if (timeline) { timeline.kill(); timeline = null; }
      modal.classList.add("hidden");
      document.removeEventListener("keydown", onKey);
      $("levelUpContent").style.opacity = 0;
      $("levelUpContent").querySelector(".level-up-badge-bob").classList.remove("is-bobbing");
      $("levelUpConfetti").innerHTML = "";
      if (returnFocus && document.contains(returnFocus)) returnFocus.focus({ preventScroll: true });
    };
  })();
</script>
