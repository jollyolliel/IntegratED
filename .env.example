# Copy to .env for local development. Real values never go in this file.

# The environment: development | production (required, no default; settings.py).
# Production services set APP_ENV=production in their own config, never from here.
APP_ENV=development

SECRET_KEY=change-me
# Required in production. Leave empty locally: the Google button opens /dev/google-sign-in instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production only: Postgres and the GCS bucket. Development uses instance/site.db and instance/bucket/.
# DATABASE_URL=
# GCS_BUCKET_NAME=
# Development only: keep the dev bucket somewhere other than instance/bucket/.
# LOCAL_BUCKET_DIR=

# AI assistant
GEMINI_AISTUDIO_API_KEY=

# Analytics (leave POSTHOG_API_KEY empty to send nothing)
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PERSONAL_API_KEY=

# Text-to-speech. Generation costs credits, so it is off unless TTS_ENABLED=true.
TTS_ENABLED=false
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVEN_MODEL_ID=eleven_v3

# Donations
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Shown on the legal pages and in the footer; each is omitted when empty.
CONTACT_EMAIL=
GITHUB_REPO_URL=
